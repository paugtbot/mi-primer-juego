        <string name="Source"><![CDATA[--!strict
-- 🤪 LOCURA TOTAL - Script principal del servidor
-- Construye el mundo, prepara a los jugadores y arranca el bucle del juego.

local Juego = require(script.Juego)
local Jugadores = require(script.Jugadores)
local Lobby = require(script.Lobby)

Lobby.Construir()
Jugadores.Iniciar()
Juego.Iniciar()

print("🤪 LOCURA TOTAL está listo. ¡Que empiece la locura!")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Constructor</string>
          <string name="Source"><![CDATA[--!strict
-- 🧱 Funciones para construir piezas rápido (partes, discos, bolas, carteles...).

local Constructor = {}

export type Props = { [string]: any }

-- Aplica propiedades a una instancia. Claves especiales:
--   Tags = {"Etiqueta1", ...}   -> etiquetas de CollectionService
--   Atributos = {Nombre = valor} -> atributos
--   Parent se asigna al final (más eficiente)
function Constructor.Aplicar(instancia: Instance, props: Props?)
	if not props then
		return
	end
	for clave, valor in props do
		if clave ~= "Parent" and clave ~= "Tags" and clave ~= "Atributos" then
			(instancia :: any)[clave] = valor
		end
	end
	if props.Atributos then
		for nombre, valor in props.Atributos do
			instancia:SetAttribute(nombre, valor)
		end
	end
	if props.Tags then
		for _, etiqueta in props.Tags do
			instancia:AddTag(etiqueta)
		end
	end
	if props.Parent then
		instancia.Parent = props.Parent
	end
end

local function base(parte: BasePart)
	parte.Anchored = true
	parte.TopSurface = Enum.SurfaceType.Smooth
	parte.BottomSurface = Enum.SurfaceType.Smooth
	parte.Material = Enum.Material.SmoothPlastic
end

-- Bloque normal.
function Constructor.Parte(props: Props?): Part
	local parte = Instance.new("Part")
	base(parte)
	Constructor.Aplicar(parte, props)
	return parte
end

-- Disco (cilindro tumbado en vertical). `arriba` es el centro de la cara de arriba.
function Constructor.Disco(arriba: Vector3, radio: number, grosor: number, props: Props?): Part
	local parte = Instance.new("Part")
	base(parte)
	parte.Shape = Enum.PartType.Cylinder
	parte.Size = Vector3.new(grosor, radio * 2, radio * 2)
	parte.CFrame = CFrame.new(arriba - Vector3.new(0, grosor / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	Constructor.Aplicar(parte, props)
	return parte
end

-- Bola.
function Constructor.Bola(centro: Vector3, diametro: number, props: Props?): Part
	local parte = Instance.new("Part")
	base(parte)
	parte.Shape = Enum.PartType.Ball
	parte.Size = Vector3.new(diametro, diametro, diametro)
	parte.CFrame = CFrame.new(centro)
	Constructor.Aplicar(parte, props)
	return parte
end

-- Rampa (cuña).
function Constructor.Cuna(props: Props?): WedgePart
	local parte = Instance.new("WedgePart")
	base(parte)
	Constructor.Aplicar(parte, props)
	return parte
end

-- Cartel con texto pegado a una cara de una parte.
function Constructor.Cartel(
	parte: BasePart,
	cara: Enum.NormalId,
	texto: string,
	colorTexto: Color3?,
	pixelesPorStud: number?
): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = cara
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelesPorStud or 25
	gui.LightInfluence = 0
	gui.Parent = parte

	local etiqueta = Instance.new("TextLabel")
	etiqueta.Size = UDim2.fromScale(1, 1)
	etiqueta.BackgroundTransparency = 1
	etiqueta.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
	etiqueta.TextScaled = true
	etiqueta.Text = texto
	etiqueta.TextColor3 = colorTexto or Color3.new(1, 1, 1)
	etiqueta.TextStrokeTransparency = 0
	etiqueta.TextStrokeColor3 = Color3.new(0, 0, 0)
	etiqueta.Parent = gui
	return etiqueta
end

-- Texto flotante que siempre mira a la cámara.
function Constructor.Flotante(
	adornee: BasePart,
	texto: string,
	alto: number,
	ancho: number,
	desplazamiento: Vector3?,
	color: Color3?
): (BillboardGui, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(ancho, alto)
	gui.StudsOffset = desplazamiento or Vector3.new(0, 3, 0)
	gui.LightInfluence = 0
	gui.Adornee = adornee
	gui.MaxDistance = 400
	gui.Parent = adornee

	local etiqueta = Instance.new("TextLabel")
	etiqueta.Size = UDim2.fromScale(1, 1)
	etiqueta.BackgroundTransparency = 1
	etiqueta.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
	etiqueta.TextScaled = true
	etiqueta.Text = texto
	etiqueta.TextColor3 = color or Color3.new(1, 1, 1)
	etiqueta.TextStrokeTransparency = 0
	etiqueta.Parent = gui
	return gui, etiqueta
end

-- Une dos partes para que se muevan juntas.
function Constructor.Soldar(a: BasePart, b: BasePart): WeldConstraint
	local soldadura = Instance.new("WeldConstraint")
	soldadura.Part0 = a
	soldadura.Part1 = b
	soldadura.Parent = a
	return soldadura
end

-- Luz de colores.
function Constructor.Luz(parte: BasePart, color: Color3, brillo: number?, alcance: number?): PointLight
	local luz = Instance.new("PointLight")
	luz.Color = color
	luz.Brightness = brillo or 2
	luz.Range = alcance or 16
	luz.Parent = parte
	return luz
end

-- Puntos de aparición en círculo, mirando al centro. `centro` está a ras de suelo.
function Constructor.Circulo(centro: Vector3, radio: number, cantidad: number): { CFrame }
	local lista = {}
	for i = 1, cantidad do
		local angulo = (i - 1) / cantidad * math.pi * 2 + math.pi / cantidad
		local posicion = centro + Vector3.new(math.cos(angulo) * radio, 0, math.sin(angulo) * radio)
		table.insert(lista, CFrame.lookAt(posicion, Vector3.new(centro.X, posicion.Y, centro.Z)))
	end
	return lista
end

-- Puntos de aparición en filas (para carreras), mirando hacia +Z.
function Constructor.Parrilla(centro: Vector3, columnas: number, filas: number, separacion: number): { CFrame }
	local lista = {}
	for f = 1, filas do
		for c = 1, columnas do
			local x = (c - (columnas + 1) / 2) * separacion
			local z = (f - (filas + 1) / 2) * separacion
			local posicion = centro + Vector3.new(x, 0, z)
			table.insert(lista, CFrame.lookAt(posicion, posicion + Vector3.new(0, 0, 1)))
		end
	end
	return lista
end

-- Barra giratoria con motor (para licuadoras). Devuelve la barra y la bisagra.
-- La barra gira alrededor del eje Y que pasa por `centro`.
function Constructor.BarraGiratoria(
	centro: Vector3,
	largo: number,
	grosor: number,
	velocidad: number,
	color: Color3,
	padre: Instance
): (Part, HingeConstraint)
	local eje = Constructor.Parte({
		Name = "EjeBarra",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(centro),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = padre,
	})

	local barra = Constructor.Parte({
		Name = "Barra",
		Size = Vector3.new(largo, grosor, grosor),
		CFrame = CFrame.new(centro),
		Color = color,
		Material = Enum.Material.Neon,
		Anchored = false,
		CustomPhysicalProperties = PhysicalProperties.new(3, 0.3, 0.5),
		Parent = padre,
	})

	-- El eje principal de las Attachment es X; lo giramos para que apunte hacia arriba (Y).
	local giro = CFrame.Angles(0, 0, math.rad(90))
	local a0 = Instance.new("Attachment")
	a0.CFrame = giro
	a0.Parent = eje
	local a1 = Instance.new("Attachment")
	a1.CFrame = giro
	a1.Parent = barra

	local bisagra = Instance.new("HingeConstraint")
	bisagra.Attachment0 = a0
	bisagra.Attachment1 = a1
	bisagra.ActuatorType = Enum.ActuatorType.Motor
	bisagra.MotorMaxTorque = math.huge
	bisagra.MotorMaxAcceleration = math.huge
	bisagra.AngularVelocity = velocidad
	bisagra.Parent = barra

	-- El servidor controla la barra para que todos la vean igual.
	pcall(function()
		barra:SetNetworkOwner(nil)
	end)

	return barra, bisagra
end

return Constructor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Efectos</string>
          <string name="Source"><![CDATA[--!strict
-- 💥 Efectos del servidor: explosiones, empujones, confeti y fuegos artificiales.

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Compartido.Config)
local Remotos = require(ReplicatedStorage.Compartido.Remotos)

local Efectos = {}

-- Explosión visual (no mata a nadie, solo hace bonito y ruido).
function Efectos.Explosion(posicion: Vector3, radio: number)
	local explosion = Instance.new("Explosion")
	explosion.Position = posicion
	explosion.BlastRadius = radio
	explosion.BlastPressure = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Parent = workspace
	Debris:AddItem(explosion, 3)
end

-- Lanza a un jugador por los aires. El propio jugador aplica la fuerza
-- en su ordenador (así funciona siempre, aunque su personaje sea "suyo").
function Efectos.Empujar(jugador: Player, velocidad: Vector3, segundosVolando: number?)
	Remotos.Empujon:FireClient(jugador, velocidad, segundosVolando or 0)
end

local function emisorConfeti(padre: Instance): ParticleEmitter
	local emisor = Instance.new("ParticleEmitter")
	emisor.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emisor.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Config.COLORES[1]),
		ColorSequenceKeypoint.new(0.25, Config.COLORES[3]),
		ColorSequenceKeypoint.new(0.5, Config.COLORES[4]),
		ColorSequenceKeypoint.new(0.75, Config.COLORES[5]),
		ColorSequenceKeypoint.new(1, Config.COLORES[7]),
	})
	emisor.Size = NumberSequence.new(0.6, 0.2)
	emisor.Lifetime = NumberRange.new(1.5, 3)
	emisor.Speed = NumberRange.new(25, 45)
	emisor.SpreadAngle = Vector2.new(60, 60)
	emisor.Acceleration = Vector3.new(0, -30, 0)
	emisor.RotSpeed = NumberRange.new(-200, 200)
	emisor.LightEmission = 0.6
	emisor.Parent = padre
	return emisor
end

-- Explosión de confeti en un punto.
-- (Usamos una ráfaga corta en vez de Emit(): un emisor recién creado en el
-- servidor a veces todavía no ha llegado a los jugadores y no se vería.)
function Efectos.Confeti(posicion: Vector3, cantidad: number?)
	local parte = Instance.new("Part")
	parte.Anchored = true
	parte.CanCollide = false
	parte.CanQuery = false
	parte.CanTouch = false
	parte.Transparency = 1
	parte.Size = Vector3.new(1, 1, 1)
	parte.CFrame = CFrame.new(posicion)
	local emisor = emisorConfeti(parte)
	emisor.Rate = (cantidad or 80) / 0.35
	emisor.Enabled = true
	parte.Parent = workspace
	task.delay(0.35, function()
		emisor.Enabled = false
	end)
	Debris:AddItem(parte, 5)
end

-- Fuego artificial: sube una bola brillante y explota en confeti.
function Efectos.FuegoArtificial(desde: Vector3)
	local color = Config.COLORES[math.random(1, #Config.COLORES)]
	local cohete = Instance.new("Part")
	cohete.Shape = Enum.PartType.Ball
	cohete.Size = Vector3.new(1.5, 1.5, 1.5)
	cohete.Material = Enum.Material.Neon
	cohete.Color = color
	cohete.Anchored = true
	cohete.CanCollide = false
	cohete.CanQuery = false
	cohete.CanTouch = false
	cohete.CFrame = CFrame.new(desde)
	cohete.Parent = workspace

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.6, 0)
	a0.Parent = cohete
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.6, 0)
	a1.Parent = cohete
	local estela = Instance.new("Trail")
	estela.Attachment0 = a0
	estela.Attachment1 = a1
	estela.Color = ColorSequence.new(color)
	estela.Lifetime = 0.5
	estela.LightEmission = 1
	estela.Parent = cohete

	local altura = math.random(35, 60)
	local destino = desde + Vector3.new(math.random(-10, 10), altura, math.random(-10, 10))
	local tween = TweenService:Create(
		cohete,
		TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = CFrame.new(destino) }
	)
	tween:Play()
	tween.Completed:Once(function()
		Efectos.Confeti(destino, 120)
		cohete:Destroy()
	end)
end

-- Sonido en una parte (si no carga, no pasa nada).
function Efectos.Sonido(padre: Instance, id: string, volumen: number?, velocidad: number?)
	local sonido = Instance.new("Sound")
	sonido.SoundId = id
	sonido.Volume = volumen or 0.6
	sonido.PlaybackSpeed = velocidad or 1
	sonido.Parent = padre
	sonido:Play()
	Debris:AddItem(sonido, 4)
end

return Efectos
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Herramientas</string>
          <string name="Source"><![CDATA[--!strict
-- 🔨 El Martillo Loco: un martillo de goma gigante que manda a volar a los demás.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")

local Efectos = require(script.Parent.Efectos)
local Jugadores = require(script.Parent.Jugadores)

local Herramientas = {}

local ALCANCE = 9 -- distancia a la que golpea
local ESPERA = 0.7 -- segundos entre golpes

local function crearMartillo(color: Color3): Tool
	local herramienta = Instance.new("Tool")
	herramienta.Name = "Martillo Loco"
	herramienta.ToolTip = "¡Haz clic para mandar a volar a los demás!"
	herramienta.CanBeDropped = false
	herramienta.RequiresHandle = true
	-- Misma forma de agarrar que la espada clásica de Roblox.
	herramienta.GripPos = Vector3.new(0, 0, -1.5)
	herramienta.GripForward = Vector3.new(-1, 0, 0)
	herramienta.GripRight = Vector3.new(0, 1, 0)
	herramienta.GripUp = Vector3.new(0, 0, 1)

	local mango = Instance.new("Part")
	mango.Name = "Handle"
	mango.Size = Vector3.new(0.6, 0.6, 5)
	mango.Color = Color3.fromRGB(255, 221, 89)
	mango.Material = Enum.Material.SmoothPlastic
	mango.CanCollide = false
	mango.Massless = true
	mango.Parent = herramienta

	local cabeza = Instance.new("Part")
	cabeza.Name = "Cabeza"
	cabeza.Shape = Enum.PartType.Cylinder
	cabeza.Size = Vector3.new(3.2, 2.4, 2.4)
	cabeza.Color = color
	cabeza.Material = Enum.Material.SmoothPlastic
	cabeza.CanCollide = false
	cabeza.Massless = true
	cabeza.CFrame = mango.CFrame * CFrame.new(0, 0, 2.6)
	cabeza.Parent = herramienta

	local soldadura = Instance.new("WeldConstraint")
	soldadura.Part0 = mango
	soldadura.Part1 = cabeza
	soldadura.Parent = mango

	return herramienta
end

-- Da un Martillo Loco al jugador y se lo pone en la mano.
-- `fuerza` multiplica lo lejos que manda a volar (1 = normal).
function Herramientas.DarMartillo(jugador: Player, color: Color3, fuerza: number?)
	local mochila = jugador:FindFirstChildOfClass("Backpack")
	local humanoide = Jugadores.Humanoide(jugador)
	if not mochila or not humanoide then
		return
	end

	local herramienta = crearMartillo(color)
	local multiplicador = fuerza or 1
	local ultimoGolpe = 0

	herramienta.Activated:Connect(function()
		local ahora = os.clock()
		if ahora - ultimoGolpe < ESPERA then
			return
		end
		ultimoGolpe = ahora

		local raiz = Jugadores.Raiz(jugador)
		if not raiz then
			return
		end

		-- Animación de golpe (el script Animate de Roblox la reconoce).
		local animacion = Instance.new("StringValue")
		animacion.Name = "toolanim"
		animacion.Value = "Slash"
		animacion.Parent = herramienta
		Debris:AddItem(animacion, 1)

		local mango = herramienta:FindFirstChild("Handle")
		if mango then
			Efectos.Sonido(mango, "rbxasset://sounds/swordlunge.wav", 0.7, 0.8 + math.random() * 0.4)
		end

		local adelante = raiz.CFrame.LookVector
		for _, otro in Players:GetPlayers() do
			if otro ~= jugador then
				local raizOtro = Jugadores.Raiz(otro)
				if raizOtro and Jugadores.EstaVivo(otro) then
					local diferencia = raizOtro.Position - raiz.Position
					local distancia = diferencia.Magnitude
					if distancia <= ALCANCE and distancia > 0.01 then
						local plano = Vector3.new(diferencia.X, 0, diferencia.Z)
						local direccion = if plano.Magnitude > 0.01 then plano.Unit else adelante
						-- Solo golpea lo que tienes delante (o pegado a ti).
						if direccion:Dot(adelante) > 0.2 or distancia < 3.5 then
							local velocidad = direccion * 85 * multiplicador + Vector3.new(0, 45 * multiplicador, 0)
							Efectos.Empujar(otro, velocidad, 1)
							Efectos.Sonido(raizOtro, "rbxasset://sounds/swordslash.wav", 0.8, 0.6)
						end
					end
				end
			end
		end
	end)

	herramienta.Parent = mochila
	humanoide:EquipTool(herramienta)
end

return Herramientas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Juego</string>
          <string name="Source"><![CDATA[--!strict
-- 🔁 EL BUCLE DEL JUEGO:
-- esperar jugadores -> ruleta -> minijuego -> resultados -> ... -> ¡CAMPEÓN!

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Compartido.Config)
local Remotos = require(ReplicatedStorage.Compartido.Remotos)
local Efectos = require(script.Parent.Efectos)
local Jugadores = require(script.Parent.Jugadores)
local Lobby = require(script.Parent.Lobby)
local Modificadores = require(script.Parent.Modificadores)
local Ronda = require(script.Parent.Ronda)

local Minijuegos = script.Parent.Minijuegos
local LISTA: { Ronda.Minijuego } = {
	require(Minijuegos.SueloQueCae),
	require(Minijuegos.Meteoritos),
	require(Minijuegos.ReyColina),
	require(Minijuegos.PatataBomba),
	require(Minijuegos.Licuadora),
	require(Minijuegos.CarreraLoca),
	require(Minijuegos.SumoHielo),
	require(Minijuegos.RampaRodante),
}

local Juego = {}

local DORADO = Color3.fromRGB(255, 205, 40)
local VERDE = Color3.fromRGB(46, 213, 115)

local function estado(datos: { [string]: any })
	Remotos.Estado:FireAllClients(datos)
end

local function anuncio(texto: string, opciones: { [string]: any }?)
	Remotos.Anuncio:FireAllClients(texto, opciones or {})
end

local function minimoJugadores(): number
	return if RunService:IsStudio() then 1 else Config.MIN_JUGADORES
end

-- ===== Elegir minijuego (sin repetir hasta que salgan todos) =====

local bolsa: { Ronda.Minijuego } = {}
local ultimo: Ronda.Minijuego? = nil

local function siguienteMinijuego(): Ronda.Minijuego
	if #bolsa == 0 then
		for _, minijuego in LISTA do
			table.insert(bolsa, minijuego)
		end
		for i = #bolsa, 2, -1 do
			local j = math.random(1, i)
			bolsa[i], bolsa[j] = bolsa[j], bolsa[i]
		end
		-- Que no salga el mismo dos veces seguidas.
		if ultimo and bolsa[#bolsa] == ultimo and #bolsa > 1 then
			bolsa[#bolsa], bolsa[1] = bolsa[1], bolsa[#bolsa]
		end
	end
	local elegido = table.remove(bolsa) :: Ronda.Minijuego
	ultimo = elegido
	return elegido
end

-- ===== Fases =====

local function esperarJugadores()
	local soloDesde: number? = nil
	while true do
		local listos = #Jugadores.Listos()
		local minimo = minimoJugadores()
		if listos >= minimo then
			return
		end
		if listos >= 1 then
			local desde = soloDesde or os.clock()
			soloDesde = desde
			local falta = Config.ESPERA_SOLO - (os.clock() - desde)
			if falta <= 0 then
				anuncio("🧪 MODO PRÁCTICA", { Subtitulo = "¡Invita a tus amigos para jugar de verdad!", Duracion = 3 })
				return
			end
			estado({
				Fase = "espera",
				Texto = `⏳ Esperando locos ({listos}/{minimo}) · práctica en {math.ceil(falta)}`,
			})
		else
			soloDesde = nil
		end
		task.wait(1)
	end
end

local function intermedio(numero: number)
	local segundos = if RunService:IsStudio() then Config.TIEMPO_INTERMEDIO_STUDIO else Config.TIEMPO_INTERMEDIO
	for s = segundos, 1, -1 do
		estado({
			Fase = "intermedio",
			Texto = `🎲 Ronda {numero}/{Config.RONDAS_POR_PARTIDA} en...`,
			Tiempo = s,
		})
		task.wait(1)
	end
end

local function ruleta(titulo: string, opciones: { string }, elegido: number, duracion: number)
	Remotos.Ruleta:FireAllClients({
		Titulo = titulo,
		Opciones = opciones,
		Elegido = elegido,
		Duracion = duracion,
	})
	task.wait(duracion + 1.3)
end

-- Por si algo falla a mitad de ronda: lo deja todo limpio.
local function limpiezaDeEmergencia()
	Modificadores.QuitarMundo()
	local arena = workspace:FindFirstChild("Arena")
	if arena then
		arena:Destroy()
	end
	for _, jugador in Players:GetPlayers() do
		if Jugadores.EnRonda[jugador] then
			Jugadores.EnRonda[jugador] = nil
			Jugadores.Reaparecer(jugador)
		end
	end
end

local function jugarRonda(numero: number): boolean
	local minijuego = siguienteMinijuego()
	local modificador = Modificadores.Elegir(numero)

	-- 🎲 Ruleta del minijuego
	local nombres = {}
	local indice = 1
	for i, m in LISTA do
		table.insert(nombres, `{m.Emoji} {m.Nombre}`)
		if m == minijuego then
			indice = i
		end
	end
	estado({ Fase = "ruleta", Texto = `🎲 Ronda {numero}/{Config.RONDAS_POR_PARTIDA}: ¡girando la ruleta!` })
	ruleta("🎲 MINIJUEGO", nombres, indice, 3.5)

	-- 🌀 Ruleta del modo loco
	local nombresMod = {}
	local indiceMod = 1
	for i, m in Modificadores.Lista do
		table.insert(nombresMod, `{m.Emoji} {m.Nombre}`)
		if m.Id == modificador.Id then
			indiceMod = i
		end
	end
	ruleta("🌀 MODO LOCO", nombresMod, indiceMod, 3)
	if modificador.Id ~= "Normal" then
		anuncio(`{modificador.Emoji} {modificador.Nombre}`, {
			Subtitulo = modificador.Descripcion,
			Color = Color3.fromRGB(165, 94, 234),
			Duracion = 2.5,
		})
		task.wait(2.5)
	end

	local participantes = Jugadores.Listos()
	if #participantes == 0 then
		return false
	end

	-- 🏗️ Construir la arena y llevar a todos
	local ronda = Ronda.new(minijuego, modificador, participantes)
	estado({ Fase = "preparando", Texto = `{minijuego.Emoji} Preparando {minijuego.Nombre}...` })
	ronda:Construir()
	Modificadores.AplicarMundo(modificador)
	ronda:Preparar()

	-- 📢 Instrucciones mientras están congelados
	anuncio(`{minijuego.Emoji} {minijuego.Nombre}`, {
		Subtitulo = minijuego.Descripcion,
		Color = DORADO,
		Duracion = 4.5,
	})
	estado({
		Fase = "preparando",
		Texto = `{minijuego.Emoji} {minijuego.Nombre}`,
		Modo = `{modificador.Emoji} {modificador.Nombre}`,
	})
	task.wait(5)
	for i = 3, 1, -1 do
		anuncio(tostring(i), { Duracion = 0.9, Cuenta = true })
		task.wait(1)
	end
	anuncio("¡YA!", { Duracion = 1, Color = VERDE, Cuenta = true, Final = true })
	ronda:Iniciar()

	-- ⏱️ Jugar hasta que se acabe el tiempo o el minijuego termine
	local fin = os.clock() + minijuego.Duracion
	while not ronda.Terminada do
		local restante = fin - os.clock()
		if restante <= 0 then
			break
		end
		ronda.TiempoRestante = math.ceil(restante)
		estado(ronda:EstadoCliente())
		task.wait(0.25)
	end
	local porTiempo = not ronda.Terminada
	ronda.TiempoRestante = 0
	ronda:Detener()
	anuncio(if porTiempo then "⏰ ¡TIEMPO!" else "🏁 ¡FIN!", { Duracion = 2, Color = Color3.fromRGB(255, 165, 2) })
	local final = ronda:EstadoCliente()
	final.Fase = "fin"
	estado(final)
	task.wait(2)

	-- 🏆 Resultados y puntos
	local filas = ronda:Ranking()
	local datosFilas = {}
	local ganadores = {}
	for _, fila in filas do
		local puntos = Config.PUNTOS_POR_PUESTO[fila.Puesto] or 1
		Jugadores.SumarPuntos(fila.Jugador, puntos)
		table.insert(datosFilas, {
			Puesto = fila.Puesto,
			Nombre = fila.Jugador.DisplayName,
			Id = fila.Jugador.UserId,
			Detalle = fila.Detalle,
			Puntos = puntos,
			Total = Jugadores.Puntos(fila.Jugador),
		})
		if fila.Puesto == 1 then
			table.insert(ganadores, fila.Jugador.DisplayName)
			local raiz = Jugadores.Raiz(fila.Jugador)
			if raiz then
				Efectos.Confeti(raiz.Position + Vector3.new(0, 5, 0), 120)
			end
		end
	end
	if #ganadores > 0 then
		anuncio(`🏆 ¡{table.concat(ganadores, " y ")} gana!`, { Color = DORADO, Duracion = 3 })
	end
	Remotos.Resultados:FireAllClients({
		Titulo = `{minijuego.Emoji} {minijuego.Nombre}`,
		Filas = datosFilas,
		Duracion = Config.TIEMPO_RESULTADOS,
	})
	estado({ Fase = "resultados", Texto = "📊 Resultados de la ronda" })
	task.wait(Config.TIEMPO_RESULTADOS)

	-- 🧹 Volver al lobby
	Modificadores.QuitarMundo()
	ronda:Limpiar()
	return true
end

-- 👑 Ceremonia final con podio, confeti y fuegos artificiales.
local function ceremonia()
	local lista = Players:GetPlayers()
	if #lista == 0 then
		return
	end
	table.sort(lista, function(a, b)
		return Jugadores.Puntos(a) > Jugadores.Puntos(b)
	end)
	local maximo = Jugadores.Puntos(lista[1])
	local campeones = {}
	for _, jugador in lista do
		if Jugadores.Puntos(jugador) == maximo and maximo > 0 then
			table.insert(campeones, jugador.DisplayName)
			Jugadores.SumarCorona(jugador)
		end
	end
	if #campeones == 0 then
		Jugadores.ReiniciarPuntos()
		return
	end

	estado({ Fase = "ceremonia", Texto = "👑 ¡CEREMONIA DE CAMPEONES! 👑" })
	task.wait(1.5) -- que todos terminen de aparecer en el lobby

	local podio = {}
	for i = 1, math.min(3, #lista) do
		local jugador = lista[i]
		local personaje = jugador.Character
		local arriba = Lobby.Podio[i]
		if personaje and arriba then
			personaje:PivotTo(CFrame.lookAt(arriba + Vector3.new(0, 3.5, 0), arriba + Vector3.new(0, 3.5, 10)))
			local humanoide = Jugadores.Humanoide(jugador)
			if humanoide then
				humanoide.WalkSpeed = 0
				humanoide.JumpPower = 0
				task.delay(Config.TIEMPO_CEREMONIA - 2, function()
					if humanoide.Parent then
						humanoide.WalkSpeed = Config.VELOCIDAD_BASE
						humanoide.JumpPower = Config.SALTO_BASE
					end
				end)
			end
		end
		table.insert(podio, {
			Puesto = i,
			Nombre = jugador.DisplayName,
			Id = jugador.UserId,
			Puntos = Jugadores.Puntos(jugador),
		})
	end

	Remotos.Campeon:FireAllClients({ Nombres = campeones, Podio = podio })
	anuncio(`👑 ¡{table.concat(campeones, " y ")}: CAMPEÓN! 👑`, {
		Subtitulo = `{maximo} puntos · ¡Ganas una CORONA!`,
		Color = DORADO,
		Duracion = 6,
	})

	local fin = os.clock() + Config.TIEMPO_CEREMONIA
	while os.clock() < fin do
		Efectos.FuegoArtificial(Lobby.Podio[1] + Vector3.new(math.random(-30, 30), 0, math.random(-12, 12)))
		task.wait(0.4)
	end
	Jugadores.ReiniciarPuntos()
end

local function bucle()
	while true do
		esperarJugadores()
		local jugadas = 0
		for numero = 1, Config.RONDAS_POR_PARTIDA do
			if #Players:GetPlayers() == 0 then
				break
			end
			intermedio(numero)
			local ok, resultado = pcall(jugarRonda, numero)
			if not ok then
				warn("[LocuraTotal] Error en la ronda:", resultado)
				limpiezaDeEmergencia()
				task.wait(2)
			elseif resultado then
				jugadas += 1
			end
		end
		if jugadas > 0 then
			local ok, err = pcall(ceremonia :: any)
			if not ok then
				warn("[LocuraTotal] Error en la ceremonia:", err)
				Jugadores.ReiniciarPuntos()
			end
		end
		task.wait(1)
	end
end

function Juego.Iniciar()
	task.spawn(bucle)
end

return Juego
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Jugadores</string>
          <string name="Source"><![CDATA[--!strict
-- 👥 Gestión de jugadores: entrar, salir, aparecer, puntos y coronas guardadas.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Compartido.Config)

local Jugadores = {}

-- Jugadores que están ahora mismo dentro de un minijuego.
Jugadores.EnRonda = {} :: { [Player]: boolean }

local cargando: { [Player]: boolean } = {}

-- Guardado de coronas (solo funciona si el juego está publicado y
-- "Enable Studio Access to API Services" está activado; si no, se ignora).
local almacen: DataStore? = nil
do
	local ok, resultado = pcall(function()
		return DataStoreService:GetDataStore("LocuraTotal_Coronas_v1")
	end)
	if ok then
		almacen = resultado
	end
end

local function clave(jugador: Player): string
	return "jugador_" .. jugador.UserId
end

local function valor(jugador: Player, nombre: string): IntValue?
	local stats = jugador:FindFirstChild("leaderstats")
	if not stats then
		return nil
	end
	local v = stats:FindFirstChild(nombre)
	if v and v:IsA("IntValue") then
		return v
	end
	return nil
end

local function guardar(jugador: Player)
	local tienda = almacen
	local coronas = valor(jugador, "Coronas")
	if not tienda or not coronas then
		return
	end
	local cantidad = coronas.Value
	local ok, err = pcall(function()
		tienda:SetAsync(clave(jugador), cantidad)
	end)
	if not ok then
		warn("[LocuraTotal] No se pudieron guardar las coronas:", err)
	end
end

local function cargar(jugador: Player)
	local tienda = almacen
	local coronas = valor(jugador, "Coronas")
	if not tienda or not coronas then
		return
	end
	local ok, resultado = pcall(function()
		return tienda:GetAsync(clave(jugador))
	end)
	if ok and typeof(resultado) == "number" then
		coronas.Value = resultado
	end
end

-- ===== Consultas útiles =====

function Jugadores.Humanoide(jugador: Player): Humanoid?
	local personaje = jugador.Character
	if not personaje then
		return nil
	end
	return personaje:FindFirstChildOfClass("Humanoid")
end

function Jugadores.Raiz(jugador: Player): BasePart?
	local personaje = jugador.Character
	if not personaje then
		return nil
	end
	local raiz = personaje:FindFirstChild("HumanoidRootPart")
	if raiz and raiz:IsA("BasePart") then
		return raiz
	end
	return nil
end

function Jugadores.EstaVivo(jugador: Player): boolean
	local humanoide = Jugadores.Humanoide(jugador)
	return humanoide ~= nil and humanoide.Health > 0 and Jugadores.Raiz(jugador) ~= nil
end

-- Jugadores con el personaje vivo y listo para jugar.
function Jugadores.Listos(): { Player }
	local lista = {}
	for _, jugador in Players:GetPlayers() do
		if Jugadores.EstaVivo(jugador) and not cargando[jugador] then
			table.insert(lista, jugador)
		end
	end
	return lista
end

-- Vuelve a crear el personaje del jugador en el lobby.
function Jugadores.Reaparecer(jugador: Player)
	if cargando[jugador] or jugador.Parent ~= Players then
		return
	end
	cargando[jugador] = true
	task.spawn(function()
		-- LoadCharacterAsync es la versión nueva; si no existe, usamos la clásica.
		local ok, err = pcall(function()
			(jugador :: any):LoadCharacterAsync()
		end)
		if not ok and jugador.Parent == Players and not jugador.Character then
			ok, err = pcall(function()
				(jugador :: any):LoadCharacter()
			end)
		end
		if not ok then
			warn("[LocuraTotal] Error al reaparecer:", err)
		end
		cargando[jugador] = nil
	end)
end

-- ===== Puntos y coronas =====

function Jugadores.SumarPuntos(jugador: Player, cantidad: number)
	local puntos = valor(jugador, "Puntos")
	if puntos then
		puntos.Value += cantidad
	end
end

function Jugadores.Puntos(jugador: Player): number
	local puntos = valor(jugador, "Puntos")
	return if puntos then puntos.Value else 0
end

function Jugadores.ReiniciarPuntos()
	for _, jugador in Players:GetPlayers() do
		local puntos = valor(jugador, "Puntos")
		if puntos then
			puntos.Value = 0
		end
	end
end

function Jugadores.SumarCorona(jugador: Player)
	local coronas = valor(jugador, "Coronas")
	if coronas then
		coronas.Value += 1
		task.spawn(guardar, jugador)
	end
end

-- ===== Eventos =====

local function alAparecer(jugador: Player, personaje: Model)
	local encontrado = personaje:WaitForChild("Humanoid", 10)
	if not encontrado or not encontrado:IsA("Humanoid") then
		return
	end
	local humanoide = encontrado :: Humanoid
	humanoide.UseJumpPower = true
	humanoide.JumpPower = Config.SALTO_BASE
	humanoide.WalkSpeed = Config.VELOCIDAD_BASE

	humanoide.Died:Connect(function()
		task.wait(Config.TIEMPO_REAPARECER)
		if jugador.Parent == Players and jugador.Character == personaje then
			Jugadores.Reaparecer(jugador)
		end
	end)
end

local function alEntrar(jugador: Player)
	if #Players:GetPlayers() > Config.MAX_JUGADORES then
		jugador:Kick(`¡Servidor lleno! Este juego es para {Config.MAX_JUGADORES} locos como máximo. Prueba otro servidor.`)
		return
	end

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local puntos = Instance.new("IntValue")
	puntos.Name = "Puntos"
	puntos.Parent = stats
	local coronas = Instance.new("IntValue")
	coronas.Name = "Coronas"
	coronas.Parent = stats
	stats.Parent = jugador

	jugador.CharacterAdded:Connect(function(personaje)
		alAparecer(jugador, personaje)
	end)
	if jugador.Character then
		task.spawn(alAparecer, jugador, jugador.Character)
	else
		Jugadores.Reaparecer(jugador)
	end

	task.spawn(cargar, jugador)
end

function Jugadores.Iniciar()
	-- Nosotros decidimos cuándo aparece cada personaje.
	Players.CharacterAutoLoads = false

	Players.PlayerAdded:Connect(alEntrar)
	for _, jugador in Players:GetPlayers() do
		task.spawn(alEntrar, jugador)
	end

	Players.PlayerRemoving:Connect(function(jugador)
		Jugadores.EnRonda[jugador] = nil
		cargando[jugador] = nil
		guardar(jugador)
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		for _, jugador in Players:GetPlayers() do
			guardar(jugador)
		end
	end)

	-- Si alguien se cae de la isla del lobby, vuelve a aparecer.
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, jugador in Players:GetPlayers() do
				if not Jugadores.EnRonda[jugador] then
					local raiz = Jugadores.Raiz(jugador)
					if raiz and raiz.Position.Y < Config.ALTURA_VACIO_LOBBY then
						Jugadores.Reaparecer(jugador)
					end
				end
			end
		end
	end)
end

return Jugadores
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[--!strict
-- 🏝️ EL LOBBY: isla flotante con pista de baile, trampolines, cañón humano,
-- podio de campeones y una isla secreta. Todo se construye con código.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Compartido.Config)
local C = require(script.Parent.Constructor)

local Lobby = {}

local L = Config.LOBBY_CENTRO

-- Posiciones (superficie) del podio: [1] oro, [2] plata, [3] bronce.
Lobby.Podio = {
	L + Vector3.new(0, 6, -40),
	L + Vector3.new(-9, 4, -40),
	L + Vector3.new(9, 2.5, -40),
} :: { Vector3 }

local function construirLuces()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.5
	if Lighting:FindFirstChild("AtmosferaLoca") then
		return -- ya estaban puestas (vienen en el archivo del juego)
	end

	local atmosfera = Instance.new("Atmosphere")
	atmosfera.Name = "AtmosferaLoca"
	atmosfera.Density = 0.28
	atmosfera.Offset = 0.2
	atmosfera.Color = Color3.fromRGB(220, 190, 255)
	atmosfera.Decay = Color3.fromRGB(120, 100, 170)
	atmosfera.Glare = 0.3
	atmosfera.Haze = 1.2
	atmosfera.Parent = Lighting

	local resplandor = Instance.new("BloomEffect")
	resplandor.Name = "BrilloLoco"
	resplandor.Intensity = 0.7
	resplandor.Size = 28
	resplandor.Threshold = 1.6
	resplandor.Parent = Lighting

	local color = Instance.new("ColorCorrectionEffect")
	color.Name = "ColoresLocos"
	color.Saturation = 0.2
	color.Contrast = 0.05
	color.Parent = Lighting
end

local function construirIsla(centro: Vector3, radio: number, padre: Instance)
	C.Disco(centro, radio, 8, {
		Name = "Cesped",
		Color = Color3.fromRGB(96, 200, 96),
		Material = Enum.Material.Grass,
		Parent = padre,
	})
	-- Roca de debajo (forma de isla flotante).
	local capas = { { 0.9, 10 }, { 0.72, 12 }, { 0.5, 14 }, { 0.26, 16 } }
	local y = centro.Y - 8
	for _, capa in capas do
		C.Disco(Vector3.new(centro.X, y, centro.Z), radio * capa[1], capa[2], {
			Name = "Roca",
			Color = Color3.fromRGB(120, 92, 70),
			Material = Enum.Material.Rock,
			Parent = padre,
		})
		y -= capa[2]
	end
end

local function construirSpawns(padre: Instance)
	for i = 1, 8 do
		local angulo = math.rad((i - 1) * 45 + 22.5)
		local posicion = L + Vector3.new(math.cos(angulo) * 27, 0, math.sin(angulo) * 27)
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "Spawn" .. i
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.AllowTeamChangeOnTouch = false
		spawn.Duration = 0
		spawn.Size = Vector3.new(7, 1, 7)
		spawn.CFrame = CFrame.lookAt(posicion, Vector3.new(L.X, posicion.Y, L.Z))
		spawn.Color = Config.COLORES[i]
		spawn.Material = Enum.Material.Neon
		spawn.TopSurface = Enum.SurfaceType.Smooth
		spawn.Parent = padre
	end
end

local function construirPistaDisco(padre: Instance)
	local lado = 7
	local tam = 4
	for x = 1, lado do
		for z = 1, lado do
			local px = (x - (lado + 1) / 2) * tam
			local pz = (z - (lado + 1) / 2) * tam
			C.Parte({
				Name = "Baldosa",
				Size = Vector3.new(tam - 0.15, 0.4, tam - 0.15),
				CFrame = CFrame.new(L + Vector3.new(px, 0, pz)),
				Color = Config.COLORES[math.random(1, #Config.COLORES)],
				Material = Enum.Material.Neon,
				Tags = { "Disco" },
				Parent = padre,
			})
		end
	end
	-- Bola de discoteca girando encima.
	local bola = C.Bola(L + Vector3.new(0, 26, 0), 7, {
		Name = "BolaDisco",
		Color = Color3.fromRGB(230, 230, 255),
		Material = Enum.Material.Foil,
		Reflectance = 0.6,
		CanCollide = false,
		Tags = { "Girar" },
		Atributos = { VelocidadGiro = 1.5 },
		Parent = padre,
	})
	C.Luz(bola, Color3.fromRGB(255, 120, 255), 3, 40)
	C.Parte({
		Name = "Cuerda",
		Size = Vector3.new(0.2, 40, 0.2),
		CFrame = CFrame.new(L + Vector3.new(0, 49.5, 0)),
		Color = Color3.fromRGB(40, 40, 40),
		CanCollide = false,
		Parent = padre,
	})
end

local function construirCarteles(padre: Instance)
	-- Cartel gigante del título.
	local tablero = C.Parte({
		Name = "Titulo",
		Size = Vector3.new(66, 18, 2),
		CFrame = CFrame.new(L + Vector3.new(0, 28, -62)) * CFrame.Angles(0, math.pi, 0),
		Color = Color3.fromRGB(30, 20, 50),
		Parent = padre,
	})
	local titulo = C.Cartel(tablero, Enum.NormalId.Front, Config.NOMBRE_JUEGO, Color3.new(1, 1, 1), 20)
	local degradado = Instance.new("UIGradient")
	degradado.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Config.COLORES[1]),
		ColorSequenceKeypoint.new(0.2, Config.COLORES[2]),
		ColorSequenceKeypoint.new(0.4, Config.COLORES[3]),
		ColorSequenceKeypoint.new(0.6, Config.COLORES[4]),
		ColorSequenceKeypoint.new(0.8, Config.COLORES[5]),
		ColorSequenceKeypoint.new(1, Config.COLORES[7]),
	})
	degradado.Parent = titulo
	degradado:AddTag("ArcoIris")

	local subtitulo = C.Parte({
		Name = "Subtitulo",
		Size = Vector3.new(50, 5, 1),
		CFrame = CFrame.new(L + Vector3.new(0, 16, -61)) * CFrame.Angles(0, math.pi, 0),
		Color = Color3.fromRGB(255, 71, 87),
		Material = Enum.Material.Neon,
		Parent = padre,
	})
	C.Cartel(subtitulo, Enum.NormalId.Front, "8 JUGADORES · 8 MINIJUEGOS · 0 PIEDAD", Color3.new(1, 1, 1), 20)

	for _, x in { -30, 30 } do
		C.Parte({
			Name = "Poste",
			Size = Vector3.new(2, 38, 2),
			CFrame = CFrame.new(L + Vector3.new(x, 19, -63)),
			Color = Color3.fromRGB(60, 40, 90),
			Parent = padre,
		})
	end

	-- Cartel de instrucciones.
	local posicion = L + Vector3.new(-52, 9, -22)
	local reglas = C.Parte({
		Name = "ComoSeJuega",
		Size = Vector3.new(26, 16, 1),
		CFrame = CFrame.lookAt(posicion, Vector3.new(L.X, posicion.Y, L.Z)), -- la cara Front mira al centro
		Color = Color3.fromRGB(20, 20, 35),
		Parent = padre,
	})
	local texto = C.Cartel(
		reglas,
		Enum.NormalId.Front,
		"¿CÓMO SE JUEGA?\n\n🎲 La ruleta elige un minijuego loco\n🌀 ...y un MODO LOCO\n🏃 ¡Sobrevive, empuja y corre!\n🏆 Ganas puntos según tu puesto\n👑 Tras 6 rondas: ¡CAMPEÓN!",
		Color3.fromRGB(255, 221, 89),
		20
	)
	texto.TextXAlignment = Enum.TextXAlignment.Center

	-- Cartel de controles.
	local posicion2 = L + Vector3.new(52, 9, -22)
	local controles = C.Parte({
		Name = "Controles",
		Size = Vector3.new(26, 16, 1),
		CFrame = CFrame.lookAt(posicion2, Vector3.new(L.X, posicion2.Y, L.Z)),
		Color = Color3.fromRGB(20, 20, 35),
		Parent = padre,
	})
	C.Cartel(
		controles,
		Enum.NormalId.Front,
		"TRUCOS\n\n🦘 Trampolines: ¡salta en los rosas!\n🚀 Cañón humano: ¡vuela a la isla secreta!\n🔨 Martillo: haz clic para empujar\n👀 Si te eliminan: botón ESPECTAR",
		Color3.fromRGB(0, 210, 211),
		20
	)

	for _, p in { posicion, posicion2 } do
		C.Parte({
			Name = "Pata",
			Size = Vector3.new(1.5, 9, 1.5),
			CFrame = CFrame.new(Vector3.new(p.X, L.Y + 0.5, p.Z)),
			Color = Color3.fromRGB(60, 40, 90),
			Parent = padre,
		})
	end
end

local function construirPodio(padre: Instance)
	local colores = {
		Color3.fromRGB(255, 205, 40),
		Color3.fromRGB(200, 205, 215),
		Color3.fromRGB(205, 127, 50),
	}
	for i, arriba in Lobby.Podio do
		local alto = arriba.Y - L.Y
		local bloque = C.Parte({
			Name = "Podio" .. i,
			Size = Vector3.new(8, alto, 8),
			CFrame = CFrame.new(arriba - Vector3.new(0, alto / 2, 0)) * CFrame.Angles(0, math.pi, 0),
			Color = colores[i],
			Material = Enum.Material.SmoothPlastic,
			Parent = padre,
		})
		C.Cartel(bloque, Enum.NormalId.Front, tostring(i), Color3.new(1, 1, 1), 20)
	end
end

local function construirTrampolines(padre: Instance)
	for i = 0, 3 do
		local angulo = math.rad(i * 90 + 45)
		local centro = L + Vector3.new(math.cos(angulo) * 52, 0, math.sin(angulo) * 52)
		C.Disco(centro + Vector3.new(0, 0.8, 0), 6, 0.8, {
			Name = "BordeTrampolin",
			Color = Color3.fromRGB(30, 30, 30),
			Parent = padre,
		})
		local cama = C.Disco(centro + Vector3.new(0, 1.1, 0), 5, 0.4, {
			Name = "Trampolin",
			Color = Color3.fromRGB(255, 107, 203),
			Material = Enum.Material.Neon,
			Tags = { "Impulso" },
			Atributos = { Impulso = Vector3.new(0, 150, 0) },
			Parent = padre,
		})
		C.Flotante(cama, "🦘", 3, 3, Vector3.new(0, 4, 0))
	end
end

local ISLA_SECRETA = L + Vector3.new(205, 0, 0)

local function construirCanon(desde: Vector3, haciaX: number, padre: Instance)
	local base = C.Disco(desde + Vector3.new(0, 0.6, 0), 4.5, 0.6, {
		Name = "Canon",
		Color = Color3.fromRGB(255, 165, 2),
		Material = Enum.Material.Neon,
		Tags = { "Impulso" },
		Atributos = { Impulso = Vector3.new(130 * haciaX, 120, 0), Vuelo = 1.1 },
		Parent = padre,
	})
	-- Tubo decorativo inclinado.
	C.Parte({
		Name = "TuboCanon",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(9, 4, 4),
		CFrame = CFrame.new(desde + Vector3.new(-5 * haciaX, 3, 0)) * CFrame.Angles(0, 0, math.rad(if haciaX > 0 then 40 else 140)),
		Color = Color3.fromRGB(50, 50, 60),
		Material = Enum.Material.Metal,
		Parent = padre,
	})
	C.Flotante(base, "🚀 CAÑÓN HUMANO", 2, 10, Vector3.new(0, 6, 0), Color3.fromRGB(255, 165, 2))
end

local function construirIslaSecreta(padre: Instance)
	construirIsla(ISLA_SECRETA, 26, padre)
	-- Estatua de corona dorada.
	C.Parte({
		Name = "Pedestal",
		Size = Vector3.new(6, 4, 6),
		CFrame = CFrame.new(ISLA_SECRETA + Vector3.new(0, 2, 0)),
		Color = Color3.fromRGB(240, 240, 240),
		Material = Enum.Material.Marble,
		Parent = padre,
	})
	local corona = C.Disco(ISLA_SECRETA + Vector3.new(0, 7, 0), 3, 3, {
		Name = "CoronaSecreta",
		Color = Color3.fromRGB(255, 205, 40),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Girar" },
		Atributos = { VelocidadGiro = 1 },
		Parent = padre,
	})
	C.Luz(corona, Color3.fromRGB(255, 205, 40), 4, 30)
	C.Flotante(corona, "🏝️ ¡ENCONTRASTE LA ISLA SECRETA!", 2, 14, Vector3.new(0, 6, 0), Color3.fromRGB(255, 221, 89))
	construirCanon(ISLA_SECRETA + Vector3.new(-14, 0, 0), -1, padre)
end

local function construirDecoracion(padre: Instance)
	-- Pilares de neón alrededor de la isla.
	for i = 1, 8 do
		local angulo = math.rad((i - 1) * 45)
		local posicion = L + Vector3.new(math.cos(angulo) * 70, 0, math.sin(angulo) * 70)
		local pilar = C.Parte({
			Name = "Pilar",
			Size = Vector3.new(2.5, 14, 2.5),
			CFrame = CFrame.new(posicion + Vector3.new(0, 7, 0)),
			Color = Config.COLORES[i],
			Material = Enum.Material.Neon,
			Parent = padre,
		})
		C.Luz(pilar, Config.COLORES[i], 2, 20)
	end
	-- Dados gigantes flotando y girando.
	for i = 1, 6 do
		local angulo = math.rad(i * 60 + 15)
		local radio = 40 + (i % 2) * 15
		C.Parte({
			Name = "DadoLoco",
			Size = Vector3.new(5, 5, 5),
			CFrame = CFrame.new(L + Vector3.new(math.cos(angulo) * radio, 22 + (i % 3) * 6, math.sin(angulo) * radio))
				* CFrame.Angles(math.rad(45), math.rad(i * 20), 0),
			Color = Config.COLORES[(i % #Config.COLORES) + 1],
			Material = Enum.Material.Neon,
			CanCollide = false,
			Tags = { "Girar" },
			Atributos = { VelocidadGiro = 0.6 + i * 0.15 },
			Parent = padre,
		})
	end
end

-- Si el lobby ya viene en el archivo del juego (o lo has editado en Studio),
-- lo usamos tal cual; solo leemos dónde está el podio.
local function usarLobbyExistente(carpeta: Instance)
	for i = 1, 3 do
		local bloque = carpeta:FindFirstChild("Podio" .. i, true)
		if bloque and bloque:IsA("BasePart") then
			Lobby.Podio[i] = bloque.Position + Vector3.new(0, bloque.Size.Y / 2, 0)
		end
	end
end

function Lobby.Construir()
	construirLuces()

	local existente = workspace:FindFirstChild("Lobby")
	if existente then
		usarLobbyExistente(existente)
		return
	end

	local carpeta = Instance.new("Folder")
	carpeta.Name = "Lobby"
	construirIsla(L, 75, carpeta)
	construirSpawns(carpeta)
	construirPistaDisco(carpeta)
	construirCarteles(carpeta)
	construirPodio(carpeta)
	construirTrampolines(carpeta)
	construirCanon(L + Vector3.new(46, 0, 12), 1, carpeta)
	construirIslaSecreta(carpeta)
	construirDecoracion(carpeta)

	carpeta.Parent = workspace
end

return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="26">
        <Properties>
          <string name="Name">Minijuegos</string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">CarreraLoca</string>
            <string name="Source"><![CDATA[--!strict
-- 🏁 CARRERA LOCA: un circuito de obstáculos con lava, cintas, plataformas que
-- parpadean, trampolines y una licuadora. ¡El primero en llegar a la meta gana!

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Compartido.Config)
local C = require(script.Parent.Parent.Constructor)
local Efectos = require(script.Parent.Parent.Efectos)
local Jugadores = require(script.Parent.Parent.Jugadores)
local Ronda = require(script.Parent.Parent.Ronda)

type Ronda = Ronda.Ronda

local ANCHO = 26
local LARGO = 266
local ALTO_SUPERIOR = 22

type Punto = { Z: number, Y: number, Destino: CFrame }

-- Estado de la ronda actual (solo hay una a la vez).
local puntosControl: { Punto } = {}
local controlDe: { [Player]: number } = {}
local origenZ = 0
local metaZ = 0
local alturaMeta = 0
local plataformasParpadeo: { { Parte: Part, Grupo: number } } = {}
local barraMeta: Part? = nil

local LAVA = Color3.fromRGB(255, 90, 0)

local function suelo(ronda: Ronda, nombre: string, z1: number, z2: number, y: number, ancho: number?, color: Color3?): Part
	local A = ronda.Centro
	return C.Parte({
		Name = nombre,
		Size = Vector3.new(ancho or ANCHO, 2, z2 - z1),
		CFrame = CFrame.new(A.X, y - 1, (z1 + z2) / 2),
		Color = color or Color3.fromRGB(235, 235, 245),
		Parent = ronda.Carpeta,
	})
end

local function lava(ronda: Ronda, z1: number, z2: number, y: number)
	local A = ronda.Centro
	C.Parte({
		Name = "Lava",
		Size = Vector3.new(ANCHO + 30, 1, z2 - z1),
		CFrame = CFrame.new(A.X, y, (z1 + z2) / 2),
		Color = LAVA,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = ronda.Carpeta,
	})
end

local function control(ronda: Ronda, z: number, y: number)
	local A = ronda.Centro
	C.Parte({
		Name = "PuntoControl",
		Size = Vector3.new(ANCHO, 0.2, 2),
		CFrame = CFrame.new(A.X, y + 0.05, z),
		Color = Color3.fromRGB(46, 213, 115),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
		Parent = ronda.Carpeta,
	})
	local destino = CFrame.lookAt(Vector3.new(A.X, y, z + 3), Vector3.new(A.X, y, z + 10))
	table.insert(puntosControl, { Z = z, Y = y, Destino = destino })
end

local function volverAlControl(ronda: Ronda, jugador: Player)
	local indice = controlDe[jugador] or 1
	local punto = puntosControl[indice]
	if punto then
		ronda:Teletransportar(jugador, punto.Destino + Vector3.new(math.random(-8, 8), 0, 0))
	end
end

local Minijuego: Ronda.Minijuego = {
	Id = "CarreraLoca",
	Nombre = "Carrera Loca",
	Emoji = "🏁",
	Descripcion = "¡Carrera de obstáculos! Lava, cintas locas, plataformas que desaparecen y trampolines. ¡Llega a la META!",
	Tipo = "carrera",
	Duracion = 120,
	AlturaMuerte = -15,

	Construir = function(ronda: Ronda): { CFrame }
		local A = ronda.Centro
		local G = A.Y -- suelo de abajo
		local U = A.Y + ALTO_SUPERIOR -- suelo de arriba
		local z0 = A.Z - LARGO / 2
		origenZ = z0
		table.clear(puntosControl)
		table.clear(controlDe)
		table.clear(plataformasParpadeo)

		-- 1) Salida
		suelo(ronda, "Salida", z0, z0 + 20, G, nil, Color3.fromRGB(30, 144, 255))
		control(ronda, z0 + 2, G)

		-- 2) Piedras saltarinas sobre lava
		lava(ronda, z0 + 20, z0 + 66, G - 6)
		for fila = 0, 4 do
			local z = z0 + 25 + fila * 8.5
			local columnas = { -8, 0, 8 }
			table.remove(columnas, math.random(1, 3)) -- quita una al azar
			for _, x in columnas do
				C.Parte({
					Name = "Piedra",
					Size = Vector3.new(6, 1.5, 6),
					CFrame = CFrame.new(A.X + x + math.random(-2, 2), G - 0.75 + math.random(0, 2), z),
					Color = Config.COLORES[(fila % #Config.COLORES) + 1],
					Parent = ronda.Carpeta,
				})
			end
		end

		-- 3) Descanso + cinta loca que te empuja hacia atrás
		suelo(ronda, "Descanso1", z0 + 64, z0 + 74, G)
		control(ronda, z0 + 66, G)
		local cinta = suelo(ronda, "CintaLoca", z0 + 74, z0 + 110, G, nil, Color3.fromRGB(50, 50, 60))
		cinta.AssemblyLinearVelocity = Vector3.new(0, 0, -11)
		for i = 0, 5 do
			C.Parte({
				Name = "Flecha",
				Size = Vector3.new(ANCHO - 4, 0.1, 1),
				CFrame = CFrame.new(A.X, G + 0.05, z0 + 77 + i * 6),
				Color = Color3.fromRGB(255, 221, 89),
				Material = Enum.Material.Neon,
				CanCollide = false,
				CanQuery = false,
				Parent = ronda.Carpeta,
			})
		end
		for _, x in { -ANCHO / 2 - 0.5, ANCHO / 2 + 0.5 } do
			C.Parte({
				Name = "Baranda",
				Size = Vector3.new(1, 2, 36),
				CFrame = CFrame.new(A.X + x, G + 1, z0 + 92),
				Color = Color3.fromRGB(255, 71, 87),
				Parent = ronda.Carpeta,
			})
		end
		for _, pos in { Vector3.new(-6, 0, 86), Vector3.new(6, 0, 98) } do
			C.Parte({
				Name = "Poste",
				Size = Vector3.new(3, 6, 3),
				CFrame = CFrame.new(A.X + pos.X, G + 3, z0 + pos.Z),
				Color = Color3.fromRGB(255, 165, 2),
				Parent = ronda.Carpeta,
			})
		end

		-- 4) Plataformas que parpadean
		suelo(ronda, "Descanso2", z0 + 110, z0 + 118, G)
		control(ronda, z0 + 112, G)
		lava(ronda, z0 + 118, z0 + 158, G - 6)
		for fila = 0, 4 do
			for columna = -1, 1 do
				local parte = C.Parte({
					Name = "Parpadeo",
					Size = Vector3.new(7, 1, 6.5),
					CFrame = CFrame.new(A.X + columna * 8.5, G - 0.5, z0 + 122 + fila * 8),
					Color = Color3.fromRGB(0, 210, 211),
					Material = Enum.Material.Neon,
					Parent = ronda.Carpeta,
				})
				table.insert(plataformasParpadeo, { Parte = parte, Grupo = (fila + columna) % 2 })
			end
		end

		-- 5) Trampolines para subir el muro
		suelo(ronda, "Descanso3", z0 + 158, z0 + 170, G)
		control(ronda, z0 + 160, G)
		for _, x in { -8, 0, 8 } do
			C.Disco(Vector3.new(A.X + x, G + 0.4, z0 + 165), 3.2, 0.4, {
				Name = "Trampolin",
				Color = Color3.fromRGB(255, 107, 203),
				Material = Enum.Material.Neon,
				Tags = { "Impulso" },
				Atributos = { Impulso = Vector3.new(0, 120, 14) },
				Parent = ronda.Carpeta,
			})
		end
		C.Parte({
			Name = "Muro",
			Size = Vector3.new(ANCHO, ALTO_SUPERIOR, 2),
			CFrame = CFrame.new(A.X, G + ALTO_SUPERIOR / 2 - 1, z0 + 171),
			Color = Color3.fromRGB(165, 94, 234),
			Parent = ronda.Carpeta,
		})

		-- 6) Arriba: licuadora pequeña
		suelo(ronda, "Arriba1", z0 + 170, z0 + 186, U)
		control(ronda, z0 + 174, U)
		C.Disco(Vector3.new(A.X, U, z0 + 202), 16, 2, {
			Name = "DiscoLicuadora",
			Color = Color3.fromRGB(255, 221, 89),
			Parent = ronda.Carpeta,
		})
		local barra, bisagra = C.BarraGiratoria(
			Vector3.new(A.X, U + 1.2, z0 + 202),
			32,
			1.4,
			0,
			Color3.fromRGB(255, 71, 87),
			ronda.Carpeta
		)
		bisagra.AngularVelocity = 0 -- arranca cuando empieza la carrera
		barraMeta = barra

		-- 7) Puente estrecho y META
		suelo(ronda, "Arriba2", z0 + 217, z0 + 228, U)
		control(ronda, z0 + 220, U)
		suelo(ronda, "Puente", z0 + 228, z0 + 250, U, 5, Color3.fromRGB(255, 165, 2))
		suelo(ronda, "Meta", z0 + 250, z0 + LARGO, U, nil, Color3.fromRGB(46, 213, 115))
		metaZ = z0 + 254
		alturaMeta = U

		for _, x in { -ANCHO / 2 + 1, ANCHO / 2 - 1 } do
			C.Parte({
				Name = "ColumnaMeta",
				Size = Vector3.new(2, 14, 2),
				CFrame = CFrame.new(A.X + x, U + 7, metaZ),
				Color = Color3.new(1, 1, 1),
				Parent = ronda.Carpeta,
			})
		end
		local cartel = C.Parte({
			Name = "CartelMeta",
			Size = Vector3.new(ANCHO, 4, 1),
			CFrame = CFrame.new(A.X, U + 15, metaZ) * CFrame.Angles(0, math.pi, 0),
			Color = Color3.fromRGB(20, 20, 35),
			Parent = ronda.Carpeta,
		})
		C.Cartel(cartel, Enum.NormalId.Front, "🏁 META 🏁", Color3.fromRGB(255, 221, 89), 20)

		return C.Parrilla(Vector3.new(A.X, G, z0 + 10), 4, 2, 5)
	end,

	Iniciar = function(ronda: Ronda)
		-- Arranca la licuadora pequeña.
		local barra = barraMeta
		if barra then
			local bisagra = barra:FindFirstChildOfClass("HingeConstraint")
			if bisagra then
				bisagra.AngularVelocity = 1.7
			end
		end

		-- Lava: si la tocas, vuelves al último punto de control.
		for _, parte in ronda.Carpeta:GetChildren() do
			if parte:IsA("BasePart") and parte.Name == "Lava" then
				ronda:Conectar(parte.Touched, function(otra: BasePart)
					local jugador = ronda:JugadorDeParte(otra)
					if jugador then
						ronda:Caer(jugador)
					end
				end)
			end
		end

		-- Plataformas que parpadean.
		task.spawn(function()
			local grupoActivo = 0
			while ronda.Activa do
				for _, p in plataformasParpadeo do
					local activa = p.Grupo == grupoActivo
					p.Parte.CanCollide = activa
					p.Parte.Transparency = if activa then 0 else 0.85
					p.Parte.Color = Color3.fromRGB(0, 210, 211)
				end
				if not ronda:Esperar(1.3) then
					break
				end
				-- Aviso: las que van a desaparecer se ponen rojas.
				for _, p in plataformasParpadeo do
					if p.Grupo == grupoActivo then
						p.Parte.Color = Color3.fromRGB(255, 71, 87)
					end
				end
				if not ronda:Esperar(0.5) then
					break
				end
				grupoActivo = 1 - grupoActivo
			end
		end)

		-- Progreso, puntos de control, golpes de la licuadora y meta.
		local ultimoGolpe: { [Player]: number } = {}
		ronda:Bucle(0.05, function()
			for _, jugador in ronda:Vivos() do
				local raiz = Jugadores.Raiz(jugador)
				if raiz then
					local pos = raiz.Position
					-- Progreso (metros recorridos)
					local recorrido = math.max(0, pos.Z - origenZ)
					if recorrido > ronda:ObtenerPuntaje(jugador) and pos.Y > ronda.Centro.Y - 4 then
						ronda:FijarPuntaje(jugador, recorrido)
					end
					-- Puntos de control
					local actual = controlDe[jugador] or 1
					for i = actual + 1, #puntosControl do
						local punto = puntosControl[i]
						if pos.Z >= punto.Z and pos.Y >= punto.Y - 2 then
							controlDe[jugador] = i
						end
					end
					-- Licuadora
					if barra and barra.Parent and os.clock() - (ultimoGolpe[jugador] or 0) > 1 then
						local centro = Vector3.new(barra.Position.X, barra.Position.Y, barra.Position.Z)
						local rel = pos - centro
						local dir = barra.CFrame.RightVector
						local perp = math.abs(rel.X * dir.Z - rel.Z * dir.X)
						local largo = math.abs(rel.X * dir.X + rel.Z * dir.Z)
						local pies = pos.Y - 3 * ronda.Escala
						if perp < 1.0 * ronda.Escala + 1 and largo < 17 and pies < centro.Y + 0.7 and pos.Y + 1.8 * ronda.Escala > centro.Y - 0.7 then
							ultimoGolpe[jugador] = os.clock()
							local lado = if rel.X >= 0 then 1 else -1
							Efectos.Empujar(jugador, Vector3.new(lado * 60, 50, -20), 1.2)
						end
					end
					-- ¡Meta!
					if pos.Z >= metaZ and pos.Y >= alturaMeta - 2 then
						ronda:Llegar(jugador)
					end
				end
			end
		end)
	end,

	AlCaer = function(ronda: Ronda, jugador: Player)
		volverAlControl(ronda, jugador)
	end,
}

return Minijuego
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Licuadora</string>
            <string name="Source"><![CDATA[--!strict
-- 🌪️ LA LICUADORA: dos barras gigantes giran cada vez más rápido. ¡Salta o vuela!

local C = require(script.Parent.Parent.Constructor)
local Efectos = require(script.Parent.Parent.Efectos)
local Jugadores = require(script.Parent.Parent.Jugadores)
local Ronda = require(script.Parent.Parent.Ronda)

type Ronda = Ronda.Ronda

local RADIO = 42
local GROSOR_BARRA = 1.4

type Barra = {
	Parte: Part,
	Bisagra: HingeConstraint,
	Altura: number,
	VelocidadInicial: number,
	VelocidadMaxima: number,
}

local barras: { Barra } = {}

-- ¿La barra está tocando a este jugador? (cálculo geométrico, muy fiable)
local function tocaBarra(barra: Barra, centro: Vector3, raiz: BasePart, escala: number, radioBarra: number): boolean
	local relativa = raiz.Position - centro
	local direccion = barra.Parte.CFrame.RightVector
	local perpendicular = math.abs(relativa.X * direccion.Z - relativa.Z * direccion.X)
	local largo = math.abs(relativa.X * direccion.X + relativa.Z * direccion.Z)
	if perpendicular > 1.0 * escala + GROSOR_BARRA / 2 + 0.3 or largo > radioBarra + 1 then
		return false
	end
	local pies = raiz.Position.Y - 3 * escala
	local cabeza = raiz.Position.Y + 1.8 * escala
	local abajo = barra.Parte.Position.Y - GROSOR_BARRA / 2
	local arriba = barra.Parte.Position.Y + GROSOR_BARRA / 2
	return pies < arriba and cabeza > abajo
end

-- Lanza al jugador en la dirección en la que gira la barra.
local function golpear(barra: Barra, centro: Vector3, jugador: Player, raiz: BasePart)
	local radial = Vector3.new(raiz.Position.X - centro.X, 0, raiz.Position.Z - centro.Z)
	local radialUnit = if radial.Magnitude > 0.1 then radial.Unit else Vector3.new(1, 0, 0)
	local sentido = if barra.Bisagra.AngularVelocity >= 0 then 1 else -1
	-- Tangente al giro (alrededor del eje Y).
	local tangente = Vector3.new(-radialUnit.Z, 0, radialUnit.X) * -sentido
	-- Al principio solo te tira al suelo; cuando la licuadora va rápido, ¡vuelas!
	local potencia = 25 + math.abs(barra.Bisagra.AngularVelocity) * 20
	Efectos.Empujar(jugador, tangente * potencia + radialUnit * 12 + Vector3.new(0, 45, 0), 1.1)
end

local Minijuego: Ronda.Minijuego = {
	Id = "Licuadora",
	Nombre = "La Licuadora",
	Emoji = "🌪️",
	Descripcion = "¡Dos barras gigantes giran cada vez más rápido! Salta por encima o saldrás volando.",
	Tipo = "supervivencia",
	Duracion = 75,
	AlturaMuerte = -25,

	Construir = function(ronda: Ronda): { CFrame }
		local A = ronda.Centro
		local plataforma = C.Disco(A, RADIO, 3, {
			Name = "Plataforma",
			Color = Color3.fromRGB(70, 80, 115),
			Material = Enum.Material.DiamondPlate,
			Parent = ronda.Carpeta,
		})
		C.Disco(A - Vector3.new(0, 0.3, 0), RADIO + 1, 2.6, {
			Name = "Borde",
			Color = Color3.fromRGB(165, 94, 234),
			Material = Enum.Material.Neon,
			Parent = ronda.Carpeta,
		})
		local pilar = C.Disco(A + Vector3.new(0, 8, 0), 2.5, 8, {
			Name = "Pilar",
			Color = Color3.fromRGB(255, 107, 203),
			Material = Enum.Material.Neon,
			Parent = ronda.Carpeta,
		})

		table.clear(barras)
		local definiciones = {
			{ Altura = 1.2, Inicial = 0.8, Maxima = 2.3, Color = Color3.fromRGB(255, 71, 87) },
			{ Altura = 3.8, Inicial = -0.55, Maxima = -1.8, Color = Color3.fromRGB(255, 221, 89) },
		}
		for _, def in definiciones do
			local parte, bisagra =
				C.BarraGiratoria(A + Vector3.new(0, def.Altura, 0), RADIO * 2, GROSOR_BARRA, 0, def.Color, ronda.Carpeta)
			-- La barra atraviesa el pilar y no debe chocar con él.
			for _, otra in { pilar, plataforma } do
				local sinChoque = Instance.new("NoCollisionConstraint")
				sinChoque.Part0 = parte
				sinChoque.Part1 = otra
				sinChoque.Parent = parte
			end
			table.insert(barras, {
				Parte = parte,
				Bisagra = bisagra,
				Altura = def.Altura,
				VelocidadInicial = def.Inicial,
				VelocidadMaxima = def.Maxima,
			})
		end
		-- Las dos barras tampoco chocan entre sí.
		if #barras == 2 then
			local sinChoque = Instance.new("NoCollisionConstraint")
			sinChoque.Part0 = barras[1].Parte
			sinChoque.Part1 = barras[2].Parte
			sinChoque.Parent = barras[1].Parte
		end

		return C.Circulo(A, 22, 8)
	end,

	Iniciar = function(ronda: Ronda)
		local A = ronda.Centro
		local inicio = os.clock()
		local ultimoGolpe: { [Player]: number } = {}
		local turbo = false

		-- Acelera las barras poco a poco.
		ronda:Bucle(0.5, function()
			local t = os.clock() - inicio
			local progreso = math.clamp(t / 55, 0, 1)
			for _, barra in barras do
				barra.Bisagra.AngularVelocity = barra.VelocidadInicial
					+ (barra.VelocidadMaxima - barra.VelocidadInicial) * progreso
			end
			if not turbo and t > 40 then
				turbo = true
				ronda:Anunciar("🌪️ ¡MODO TURBO LICUADORA!", Color3.fromRGB(255, 71, 87), 2)
			end
		end)

		-- Detecta golpes.
		ronda:Bucle(0.03, function()
			local ahora = os.clock()
			for _, jugador in ronda:Vivos() do
				local raiz = Jugadores.Raiz(jugador)
				if raiz and ahora - (ultimoGolpe[jugador] or 0) > 1.2 then
					for _, barra in barras do
						if barra.Parte.Parent and tocaBarra(barra, A, raiz, ronda.Escala, RADIO) then
							ultimoGolpe[jugador] = ahora
							golpear(barra, A, jugador, raiz)
							break
						end
					end
				end
			end
		end)
	end,
}

return Minijuego
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Meteoritos</string>
            <string name="Source"><![CDATA[--!strict
-- ☄️ LLUVIA DE METEORITOS: caen meteoritos que rompen el suelo y te mandan a volar.

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local C = require(script.Parent.Parent.Constructor)
local Efectos = require(script.Parent.Parent.Efectos)
local Jugadores = require(script.Parent.Parent.Jugadores)
local Ronda = require(script.Parent.Parent.Ronda)

type Ronda = Ronda.Ronda

local RADIO = 46
local PASO = 9
local GROSOR = 3

local Minijuego: Ronda.Minijuego = {
	Id = "Meteoritos",
	Nombre = "Lluvia de Meteoritos",
	Emoji = "☄️",
	Descripcion = "¡Caen meteoritos del cielo! Huye de los círculos rojos. Cada vez caen más...",
	Tipo = "supervivencia",
	Duracion = 90,
	AlturaMuerte = -25,

	Construir = function(ronda: Ronda): { CFrame }
		local A = ronda.Centro
		local suelo = Instance.new("Folder")
		suelo.Name = "Suelo"
		suelo.Parent = ronda.Carpeta

		local n = math.ceil(RADIO / PASO)
		for ix = -n, n do
			for iz = -n, n do
				local x, z = ix * PASO, iz * PASO
				if x * x + z * z <= RADIO * RADIO then
					local tono = math.random(70, 110)
					C.Parte({
						Name = "Roca",
						Size = Vector3.new(PASO - 0.2, GROSOR, PASO - 0.2),
						CFrame = CFrame.new(A.X + x, A.Y - GROSOR / 2, A.Z + z),
						Color = Color3.fromRGB(tono, tono - 15, tono - 20),
						Material = Enum.Material.Basalt,
						Parent = suelo,
					})
				end
			end
		end
		return C.Circulo(A, 20, 8)
	end,

	Iniciar = function(ronda: Ronda)
		local A = ronda.Centro
		local suelo = ronda.Carpeta:FindFirstChild("Suelo")
		if not suelo then
			return
		end
		local inicio = os.clock()
		local ultimoGolpe: { [Player]: number } = {}

		local function impacto(punto: Vector3, radioRotura: number, radioEmpuje: number)
			Efectos.Explosion(punto, radioRotura + 2)
			-- Rompe el suelo: las rocas caen al vacío.
			for _, roca in suelo:GetChildren() do
				if roca:IsA("BasePart") and roca.Anchored then
					local d = Vector3.new(roca.Position.X - punto.X, 0, roca.Position.Z - punto.Z).Magnitude
					if d <= radioRotura then
						roca.Anchored = false
						roca.CanCollide = false
						roca.AssemblyLinearVelocity = Vector3.new(math.random(-8, 8), -10, math.random(-8, 8))
						roca.AssemblyAngularVelocity = Vector3.new(math.random(-3, 3), math.random(-3, 3), math.random(-3, 3))
						Debris:AddItem(roca, 3)
					end
				end
			end
			-- Manda a volar a los jugadores cercanos.
			local ahora = os.clock()
			for _, jugador in ronda:Vivos() do
				local raiz = Jugadores.Raiz(jugador)
				if raiz and ahora - (ultimoGolpe[jugador] or 0) > 0.5 then
					local diferencia = raiz.Position - punto
					local d = diferencia.Magnitude
					if d <= radioEmpuje then
						ultimoGolpe[jugador] = ahora
						local fuerza = 1 - d / radioEmpuje
						local plano = Vector3.new(diferencia.X, 0, diferencia.Z)
						local direccion = if plano.Magnitude > 0.1 then plano.Unit else Vector3.new(1, 0, 0)
						Efectos.Empujar(jugador, direccion * (30 + 55 * fuerza) + Vector3.new(0, 40 + 45 * fuerza, 0), 1)
					end
				end
			end
		end

		local function lanzar(gigante: boolean)
			-- Elige dónde cae: a veces apunta a un jugador. ¡Cuidado!
			local objetivo: Vector3
			local vivos = ronda:Vivos()
			local raizObjetivo = if #vivos > 0 and math.random() < 0.45
				then Jugadores.Raiz(vivos[math.random(1, #vivos)])
				else nil
			if raizObjetivo then
				objetivo = Vector3.new(
					raizObjetivo.Position.X + math.random(-6, 6),
					A.Y,
					raizObjetivo.Position.Z + math.random(-6, 6)
				)
			else
				local angulo = math.random() * math.pi * 2
				local r = math.sqrt(math.random()) * (RADIO - 4)
				objetivo = A + Vector3.new(math.cos(angulo) * r, 0, math.sin(angulo) * r)
			end

			local radioAviso = if gigante then 16 else 7
			local aviso = C.Disco(objetivo + Vector3.new(0, 0.15, 0), radioAviso, 0.2, {
				Name = "Aviso",
				Color = Color3.fromRGB(255, 40, 40),
				Material = Enum.Material.Neon,
				Transparency = 0.35,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				Parent = ronda.Carpeta,
			})
			TweenService:Create(
				aviso,
				TweenInfo.new(0.2, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true),
				{ Transparency = 0.8 }
			):Play()

			if not ronda:Esperar(if gigante then 2.2 else 1.3) then
				aviso:Destroy()
				return
			end

			local tamano = if gigante then 16 else 6
			local meteorito = C.Bola(
				objetivo + Vector3.new(math.random(-30, 30), 150, math.random(-30, 30)),
				tamano,
				{
					Name = "Meteorito",
					Color = Color3.fromRGB(255, 120, 20),
					Material = Enum.Material.Neon,
					CanCollide = false,
					CanQuery = false,
					CanTouch = false,
					Parent = ronda.Carpeta,
				}
			)
			local fuego = Instance.new("Fire")
			fuego.Size = tamano * 1.5
			fuego.Heat = 20
			fuego.Parent = meteorito

			local caida = TweenService:Create(
				meteorito,
				TweenInfo.new(0.5, Enum.EasingStyle.Linear),
				{ CFrame = CFrame.new(objetivo) }
			)
			caida:Play()
			caida.Completed:Wait()
			meteorito:Destroy()
			aviso:Destroy()
			if ronda.Activa then
				if gigante then
					impacto(objetivo, 15, 22)
				else
					-- Rompe lo que hay dentro del círculo rojo y empuja un poco más allá.
					impacto(objetivo, 6.5, 10)
				end
			end
		end

		-- Meteoritos normales: cada vez más seguidos.
		task.spawn(function()
			while ronda.Activa do
				task.spawn(lanzar, false)
				local t = os.clock() - inicio
				task.wait(math.max(0.22, 1.1 - t * 0.012))
			end
		end)

		-- Meteorito GIGANTE cada 25 segundos.
		task.spawn(function()
			while ronda:Esperar(25) do
				ronda:Anunciar("☄️ ¡METEORITO GIGANTE!", Color3.fromRGB(255, 120, 20), 2)
				task.spawn(lanzar, true)
			end
		end)
	end,
}

return Minijuego
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">PatataBomba</string>
            <string name="Source"><![CDATA[--!strict
-- 💣 PATATA BOMBA: alguien lleva una bomba en la cabeza. Tócale a otro para pasársela.
-- Cuando el tiempo llega a cero... ¡BOOM!

local C = require(script.Parent.Parent.Constructor)
local Efectos = require(script.Parent.Parent.Efectos)
local Jugadores = require(script.Parent.Parent.Jugadores)
local Ronda = require(script.Parent.Parent.Ronda)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotos = require(ReplicatedStorage.Compartido.Remotos)

type Ronda = Ronda.Ronda

local LADO = 70
local ALTO_PARED = 16

type Estado = {
	Portador: Player?,
	Bomba: Part?,
	Resaltado: Highlight?,
	Texto: TextLabel?,
	ExplotaEn: number,
	UltimoPase: number,
	SiguienteEn: number?, -- cuándo sale la próxima bomba (si ahora no hay)
}

-- Solo hay una ronda a la vez, así que guardamos el estado aquí.
local estado: Estado? = nil

local function quitarBomba(e: Estado)
	local anterior = e.Portador
	if anterior then
		local humanoide = Jugadores.Humanoide(anterior)
		if humanoide and humanoide.WalkSpeed > 0 then
			humanoide.WalkSpeed = humanoide.WalkSpeed / 1.25
		end
	end
	if e.Bomba then
		e.Bomba:Destroy()
		e.Bomba = nil
	end
	if e.Resaltado then
		e.Resaltado:Destroy()
		e.Resaltado = nil
	end
	e.Texto = nil
	e.Portador = nil
end

local function ponerBomba(ronda: Ronda, e: Estado, jugador: Player): boolean
	local personaje = jugador.Character
	local cabeza = if personaje then personaje:FindFirstChild("Head") else nil
	if not personaje or not cabeza or not cabeza:IsA("BasePart") then
		return false
	end
	quitarBomba(e)

	local tamano = 2.6 * ronda.Escala
	local bomba = C.Bola(Vector3.zero, tamano, {
		Name = "Bomba",
		Color = Color3.fromRGB(25, 25, 25),
		Anchored = false,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Massless = true,
	})
	bomba.CFrame = cabeza.CFrame * CFrame.new(0, 2.4 * ronda.Escala, 0)
	local chispas = Instance.new("Sparkles")
	chispas.SparkleColor = Color3.fromRGB(255, 165, 2)
	chispas.Parent = bomba
	C.Soldar(cabeza, bomba)
	local _, texto = C.Flotante(bomba, "💣", 2.5, 4, Vector3.new(0, 2.5 * ronda.Escala, 0), Color3.fromRGB(255, 71, 87))
	bomba.Parent = personaje

	local resaltado = Instance.new("Highlight")
	resaltado.FillColor = Color3.fromRGB(255, 40, 40)
	resaltado.FillTransparency = 0.6
	resaltado.OutlineColor = Color3.fromRGB(255, 221, 89)
	resaltado.Parent = personaje

	local humanoide = Jugadores.Humanoide(jugador)
	if humanoide then
		humanoide.WalkSpeed = ronda.Velocidad * 1.25
	end

	e.Portador = jugador
	e.Bomba = bomba
	e.Resaltado = resaltado
	e.Texto = texto
	e.UltimoPase = os.clock()
	Remotos.Anuncio:FireClient(jugador, "💣 ¡TIENES LA BOMBA!", {
		Color = Color3.fromRGB(255, 71, 87),
		Duracion = 1.5,
		Subtitulo = "¡Toca a alguien para pasársela!",
	})
	return true
end

local function nuevaBomba(ronda: Ronda, e: Estado)
	local vivos = ronda:Vivos()
	if not ronda.Activa or #vivos == 0 then
		return
	end
	if #vivos == 1 and #ronda.Participantes > 1 then
		return
	end
	local elegido = vivos[math.random(1, #vivos)]
	if ponerBomba(ronda, e, elegido) then
		e.ExplotaEn = os.clock() + math.random(90, 140) / 10
		ronda:Feed(`💣 ¡{elegido.DisplayName} tiene la bomba!`)
	end
end

local function explotar(ronda: Ronda, e: Estado)
	local victima = e.Portador
	if not victima then
		return
	end
	local raiz = Jugadores.Raiz(victima)
	local posicion = if raiz then raiz.Position else ronda.Centro
	quitarBomba(e)

	Efectos.Explosion(posicion, 14)
	Efectos.Confeti(posicion, 60)
	Efectos.Empujar(victima, Vector3.new(math.random(-30, 30), 170, math.random(-30, 30)), 2)
	for _, otro in ronda:Vivos() do
		local raizOtro = Jugadores.Raiz(otro)
		if otro ~= victima and raizOtro then
			local diferencia = raizOtro.Position - posicion
			if diferencia.Magnitude < 14 then
				local plano = Vector3.new(diferencia.X, 0, diferencia.Z)
				local direccion = if plano.Magnitude > 0.1 then plano.Unit else Vector3.new(0, 0, 1)
				Efectos.Empujar(otro, direccion * 70 + Vector3.new(0, 40, 0), 0.8)
			end
		end
	end
	e.SiguienteEn = os.clock() + 2.9
	task.wait(0.4)
	ronda:Eliminar(victima, "¡EXPLOTÓ! 💥")
end

local Minijuego: Ronda.Minijuego = {
	Id = "PatataBomba",
	Nombre = "Patata Bomba",
	Emoji = "💣",
	Descripcion = "¡Alguien tiene una BOMBA en la cabeza! Si la tienes, toca a otro para pasársela antes de que explote.",
	Tipo = "supervivencia",
	Duracion = 150,
	AlturaMuerte = -20,

	Construir = function(ronda: Ronda): { CFrame }
		local A = ronda.Centro
		local colores = { Color3.fromRGB(255, 221, 89), Color3.fromRGB(255, 107, 203) }
		local n = 7
		local tam = LADO / n
		for ix = 1, n do
			for iz = 1, n do
				C.Parte({
					Name = "Suelo",
					Size = Vector3.new(tam, 2, tam),
					CFrame = CFrame.new(A + Vector3.new((ix - (n + 1) / 2) * tam, -1, (iz - (n + 1) / 2) * tam)),
					Color = colores[((ix + iz) % 2) + 1],
					Parent = ronda.Carpeta,
				})
			end
		end

		-- Paredes de cristal + paredes invisibles altas + techo (por si hay súper salto).
		local mitad = LADO / 2 + 1
		local paredes = {
			{ Vector3.new(0, 0, mitad), Vector3.new(LADO + 4, 0, 2) },
			{ Vector3.new(0, 0, -mitad), Vector3.new(LADO + 4, 0, 2) },
			{ Vector3.new(mitad, 0, 0), Vector3.new(2, 0, LADO + 4) },
			{ Vector3.new(-mitad, 0, 0), Vector3.new(2, 0, LADO + 4) },
		}
		for _, p in paredes do
			C.Parte({
				Name = "Pared",
				Size = p[2] + Vector3.new(0, ALTO_PARED, 0),
				CFrame = CFrame.new(A + p[1] + Vector3.new(0, ALTO_PARED / 2, 0)),
				Color = Color3.fromRGB(150, 220, 255),
				Material = Enum.Material.Glass,
				Transparency = 0.6,
				Parent = ronda.Carpeta,
			})
			C.Parte({
				Name = "ParedInvisible",
				Size = p[2] + Vector3.new(0, 80, 0),
				CFrame = CFrame.new(A + p[1] + Vector3.new(0, 40, 0)),
				Transparency = 1,
				Parent = ronda.Carpeta,
			})
		end
		C.Parte({
			Name = "Techo",
			Size = Vector3.new(LADO + 4, 2, LADO + 4),
			CFrame = CFrame.new(A + Vector3.new(0, 80, 0)),
			Transparency = 1,
			Parent = ronda.Carpeta,
		})

		-- Obstáculos para esconderse.
		for _, posicion in { Vector3.new(17, 0, 17), Vector3.new(-17, 0, 17), Vector3.new(17, 0, -17), Vector3.new(-17, 0, -17) } do
			C.Parte({
				Name = "Caja",
				Size = Vector3.new(7, 7, 7),
				CFrame = CFrame.new(A + posicion + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, math.rad(math.random(0, 90)), 0),
				Color = Color3.fromRGB(190, 130, 70),
				Material = Enum.Material.WoodPlanks,
				Parent = ronda.Carpeta,
			})
		end
		C.Disco(A + Vector3.new(0, 2.5, 0), 6, 2.5, {
			Name = "Centro",
			Color = Color3.fromRGB(165, 94, 234),
			Material = Enum.Material.Neon,
			Parent = ronda.Carpeta,
		})

		return C.Circulo(A, 26, 8)
	end,

	Iniciar = function(ronda: Ronda)
		local e: Estado = {
			Portador = nil,
			Bomba = nil,
			Resaltado = nil,
			Texto = nil,
			ExplotaEn = 0,
			UltimoPase = 0,
			SiguienteEn = nil,
		}
		estado = e
		nuevaBomba(ronda, e)

		ronda:Bucle(0.05, function()
			local portador = e.Portador
			if not portador then
				local siguiente = e.SiguienteEn
				if siguiente and os.clock() >= siguiente then
					e.SiguienteEn = nil
					nuevaBomba(ronda, e)
				end
				return
			end
			if not ronda:EstaVivo(portador) then
				quitarBomba(e)
				e.SiguienteEn = os.clock() + 1
				return
			end

			local restante = e.ExplotaEn - os.clock()
			if e.Texto then
				e.Texto.Text = `💣 {math.max(0, math.ceil(restante))}`
			end
			if restante <= 0 then
				explotar(ronda, e)
				return
			end

			-- ¿Está tocando a alguien? ¡Se la pasa!
			if os.clock() - e.UltimoPase < 0.8 then
				return
			end
			local raiz = Jugadores.Raiz(portador)
			if not raiz then
				return
			end
			for _, otro in ronda:Vivos() do
				if otro ~= portador then
					local raizOtro = Jugadores.Raiz(otro)
					if raizOtro and (raizOtro.Position - raiz.Position).Magnitude < 4.5 * ronda.Escala then
						if ponerBomba(ronda, e, otro) then
							ronda:Feed(`💣 {portador.DisplayName} le pasó la bomba a {otro.DisplayName}`)
						end
						return
					end
				end
			end
		end)

		-- Cuando acaba la ronda, borramos la bomba.
		task.spawn(function()
			while ronda.Activa do
				task.wait(0.5)
			end
			if estado == e then
				quitarBomba(e)
				estado = nil
			end
		end)
	end,

	AlEliminar = function(_ronda: Ronda, jugador: Player)
		local e = estado
		if e and e.Portador == jugador then
			quitarBomba(e)
			e.SiguienteEn = os.clock() + 1 -- el bucle principal pondrá otra
		end
	end,
}

return Minijuego
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">RampaRodante</string>
            <string name="Source"><![CDATA[--!strict
-- 🎳 RAMPA RODANTE: sube la rampa gigante mientras bajan bolas enormes rodando.
-- ¡El primero en llegar arriba gana! (Tú eres el bolo...)

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Compartido.Config)
local C = require(script.Parent.Parent.Constructor)
local Efectos = require(script.Parent.Parent.Efectos)
local Jugadores = require(script.Parent.Parent.Jugadores)
local Ronda = require(script.Parent.Parent.Ronda)

type Ronda = Ronda.Ronda

local ANGULO = math.rad(12)
local LARGO = 220
local ANCHO = 40
local SUBIDA = LARGO * math.sin(ANGULO) -- ~45.7

local inicioZ = 0
local salidas: { CFrame } = {}

local Minijuego: Ronda.Minijuego = {
	Id = "RampaRodante",
	Nombre = "Rampa Rodante",
	Emoji = "🎳",
	Descripcion = "¡Sube la rampa hasta arriba mientras caen BOLAS GIGANTES rodando! El primero en llegar gana.",
	Tipo = "carrera",
	Duracion = 100,
	AlturaMuerte = -25,

	Construir = function(ronda: Ronda): { CFrame }
		local A = ronda.Centro
		-- Rampa inclinada (sube hacia +Z).
		local marco = CFrame.new(A + Vector3.new(0, SUBIDA / 2, 0)) * CFrame.Angles(-ANGULO, 0, 0)
		C.Parte({
			Name = "Rampa",
			Size = Vector3.new(ANCHO, 2, LARGO),
			CFrame = marco,
			Color = Color3.fromRGB(205, 160, 110),
			Material = Enum.Material.WoodPlanks,
			Parent = ronda.Carpeta,
		})
		for _, x in { -ANCHO / 2 - 1, ANCHO / 2 + 1 } do
			C.Parte({
				Name = "Pared",
				Size = Vector3.new(2, 9, LARGO),
				CFrame = marco * CFrame.new(x, 4.5, 0),
				Color = Color3.fromRGB(150, 220, 255),
				Material = Enum.Material.Glass,
				Transparency = 0.6,
				Parent = ronda.Carpeta,
			})
		end
		-- Rayas de colores para que se vea la velocidad.
		for i = 1, 10 do
			C.Parte({
				Name = "Raya",
				Size = Vector3.new(ANCHO, 0.1, 2),
				CFrame = marco * CFrame.new(0, 1.05, -LARGO / 2 + i * 20),
				Color = Config.COLORES[(i % #Config.COLORES) + 1],
				Material = Enum.Material.Neon,
				CanCollide = false,
				CanQuery = false,
				Parent = ronda.Carpeta,
			})
		end

		-- Salida abajo.
		local abajo = marco * CFrame.new(0, 1, -LARGO / 2)
		local salidaZ = abajo.Position.Z - 12
		C.Parte({
			Name = "Salida",
			Size = Vector3.new(ANCHO, 2, 24),
			CFrame = CFrame.new(A.X, abajo.Position.Y - 1, salidaZ),
			Color = Color3.fromRGB(30, 144, 255),
			Parent = ronda.Carpeta,
		})
		inicioZ = salidaZ - 12

		-- Meta arriba.
		local arriba = marco * CFrame.new(0, 1, LARGO / 2)
		C.Parte({
			Name = "Meta",
			Size = Vector3.new(ANCHO, 2, 30),
			CFrame = CFrame.new(A.X, arriba.Position.Y - 1, arriba.Position.Z + 14.5),
			Color = Color3.fromRGB(46, 213, 115),
			Parent = ronda.Carpeta,
		})
		local cartel = C.Parte({
			Name = "CartelMeta",
			Size = Vector3.new(ANCHO, 5, 1),
			CFrame = CFrame.new(A.X, arriba.Position.Y + 16, arriba.Position.Z + 8) * CFrame.Angles(0, math.pi, 0),
			Color = Color3.fromRGB(20, 20, 35),
			Parent = ronda.Carpeta,
		})
		C.Cartel(cartel, Enum.NormalId.Front, "🏁 ¡SUBE HASTA AQUÍ! 🏁", Color3.fromRGB(255, 221, 89), 20)
		for _, x in { -ANCHO / 2 + 1, ANCHO / 2 - 1 } do
			C.Parte({
				Name = "ColumnaMeta",
				Size = Vector3.new(2, 16, 2),
				CFrame = CFrame.new(A.X + x, arriba.Position.Y + 8, arriba.Position.Z + 8),
				Color = Color3.new(1, 1, 1),
				Parent = ronda.Carpeta,
			})
		end

		salidas = C.Parrilla(Vector3.new(A.X, abajo.Position.Y, salidaZ), 4, 2, 6)
		return salidas
	end,

	Iniciar = function(ronda: Ronda)
		local A = ronda.Centro
		local inicio = os.clock()
		local bolas: { Part } = {}
		local ultimoGolpe: { [Player]: number } = {}
		local marco = CFrame.new(A + Vector3.new(0, SUBIDA / 2, 0)) * CFrame.Angles(-ANGULO, 0, 0)
		local arriba = marco * CFrame.new(0, 1, LARGO / 2)

		local function soltarBola(gigante: boolean)
			local diametro = if gigante then 26 else math.random(9, 15)
			local margen = math.floor(ANCHO / 2 - diametro / 2 - 1)
			local x = if gigante then 0 else math.random(-margen, margen)
			local salida = marco * CFrame.new(x, 1 + diametro / 2 + 1, LARGO / 2 - diametro / 2 - 4)
			local bola = C.Bola(salida.Position, diametro, {
				Name = "Bola",
				Color = Config.COLORES[math.random(1, #Config.COLORES)],
				Material = Enum.Material.SmoothPlastic,
				Anchored = false,
				CustomPhysicalProperties = PhysicalProperties.new(2, 0.4, 0.3),
				Parent = ronda.Carpeta,
			})
			bola.AssemblyLinearVelocity = marco.LookVector * 25 -- LookVector apunta rampa abajo
			pcall(function()
				bola:SetNetworkOwner(nil)
			end)
			Debris:AddItem(bola, 14)
			table.insert(bolas, bola)
		end

		-- Suelta bolas cada vez más seguido.
		task.spawn(function()
			while ronda.Activa do
				soltarBola(false)
				local t = os.clock() - inicio
				if not ronda:Esperar(math.max(0.55, 1.6 - t * 0.015)) then
					break
				end
			end
		end)

		-- BOLA GIGANTE cada 20 segundos.
		task.spawn(function()
			while ronda:Esperar(20) do
				ronda:Anunciar("🎳 ¡BOLA GIGANTE!", Color3.fromRGB(255, 165, 2), 2)
				soltarBola(true)
			end
		end)

		ronda:Bucle(0.05, function()
			-- Limpia bolas que ya cayeron.
			for i = #bolas, 1, -1 do
				local bola = bolas[i]
				if not bola.Parent or bola.Position.Y < A.Y - 40 then
					bola:Destroy()
					table.remove(bolas, i)
				end
			end

			local ahora = os.clock()
			for _, jugador in ronda:Vivos() do
				local raiz = Jugadores.Raiz(jugador)
				if raiz then
					local pos = raiz.Position
					-- Progreso
					local recorrido = math.max(0, pos.Z - inicioZ)
					if recorrido > ronda:ObtenerPuntaje(jugador) then
						ronda:FijarPuntaje(jugador, recorrido)
					end
					-- Golpes de bolas
					if ahora - (ultimoGolpe[jugador] or 0) > 1 then
						for _, bola in bolas do
							if (bola.Position - pos).Magnitude < bola.Size.X / 2 + 1.8 * ronda.Escala then
								ultimoGolpe[jugador] = ahora
								local lado = math.random(-20, 20)
								Efectos.Empujar(jugador, Vector3.new(lado, 45, -75), 1.2)
								break
							end
						end
					end
					-- ¡Meta!
					if pos.Z >= arriba.Position.Z + 3 and pos.Y >= arriba.Position.Y - 2 then
						ronda:Llegar(jugador)
					end
				end
			end
		end)
	end,

	AlCaer = function(ronda: Ronda, jugador: Player)
		if #salidas > 0 then
			ronda:Teletransportar(jugador, salidas[math.random(1, #salidas)])
		end
	end,
}

return Minijuego
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ReyColina</string>
            <string name="Source"><![CDATA[--!strict
-- 👑 REY DE LA COLINA: quédate en la cima dorada para sumar puntos.
-- ¡Todos tienen Martillo Loco para echarte!

local C = require(script.Parent.Parent.Constructor)
local Jugadores = require(script.Parent.Parent.Jugadores)
local Ronda = require(script.Parent.Parent.Ronda)

type Ronda = Ronda.Ronda

local RADIO_BASE = 50
local PISOS = { -- { radio, altura de arriba }
	{ 28, 4 },
	{ 17, 8 },
	{ 9, 12 },
}
local RADIO_ZONA = 9.5
local ALTURA_ZONA = 12

local function rampa(ronda: Ronda, anguloGrados: number, radio: number, abajo: number)
	local A = ronda.Centro
	local d = Vector3.new(math.cos(math.rad(anguloGrados)), 0, math.sin(math.rad(anguloGrados)))
	local posicion = A + d * (radio + 3.5) + Vector3.new(0, abajo + 2, 0)
	-- La parte alta de la cuña mira hacia el centro.
	C.Cuna({
		Name = "Rampa",
		Size = Vector3.new(7, 4, 8),
		CFrame = CFrame.lookAt(posicion, posicion + d),
		Color = Color3.fromRGB(200, 160, 110),
		Material = Enum.Material.WoodPlanks,
		Parent = ronda.Carpeta,
	})
end

local Minijuego: Ronda.Minijuego = {
	Id = "ReyColina",
	Nombre = "Rey de la Colina",
	Emoji = "👑",
	Descripcion = "¡Sube a la cima DORADA y quédate ahí para sumar puntos! Usa el Martillo Loco para echar a los demás.",
	Tipo = "puntos",
	Duracion = 60,
	AlturaMuerte = -30,
	Herramienta = true,
	UnidadPuntaje = "seg 👑",

	Construir = function(ronda: Ronda): { CFrame }
		local A = ronda.Centro
		C.Disco(A, RADIO_BASE, 4, {
			Name = "Base",
			Color = Color3.fromRGB(110, 210, 110),
			Material = Enum.Material.Grass,
			Parent = ronda.Carpeta,
		})
		C.Disco(A - Vector3.new(0, 0.3, 0), RADIO_BASE + 1, 3.4, {
			Name = "Borde",
			Color = Color3.fromRGB(255, 107, 203),
			Material = Enum.Material.Neon,
			Parent = ronda.Carpeta,
		})

		local colores = {
			Color3.fromRGB(140, 200, 90),
			Color3.fromRGB(170, 190, 80),
			Color3.fromRGB(255, 205, 40),
		}
		for i, piso in PISOS do
			local radio, altura = piso[1], piso[2]
			C.Disco(A + Vector3.new(0, altura, 0), radio, 4, {
				Name = "Piso" .. i,
				Color = colores[i],
				Material = if i == #PISOS then Enum.Material.Neon else Enum.Material.Grass,
				Parent = ronda.Carpeta,
			})
		end

		-- Rampas para subir (pocas, para que haya peleas).
		for _, angulo in { 0, 90, 180, 270 } do
			rampa(ronda, angulo, PISOS[1][1], 0)
		end
		for _, angulo in { 45, 225 } do
			rampa(ronda, angulo, PISOS[2][1], PISOS[1][2])
		end
		for _, angulo in { 135, 315 } do
			rampa(ronda, angulo, PISOS[3][1], PISOS[2][2])
		end

		local marcador = C.Parte({
			Name = "Marcador",
			Size = Vector3.new(1, 1, 1),
			CFrame = CFrame.new(A + Vector3.new(0, ALTURA_ZONA + 14, 0)),
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Parent = ronda.Carpeta,
		})
		C.Flotante(marcador, "👑 ZONA DEL REY 👑", 3, 16, Vector3.zero, Color3.fromRGB(255, 221, 89))

		return C.Circulo(A, 40, 8)
	end,

	Iniciar = function(ronda: Ronda)
		local A = ronda.Centro

		-- Corona flotante encima del líder.
		local soporte = C.Parte({
			Name = "Corona",
			Size = Vector3.new(1, 1, 1),
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CFrame = CFrame.new(A + Vector3.new(0, -500, 0)),
			Parent = ronda.Carpeta,
		})
		local corona, _ = C.Flotante(soporte, "👑", 4, 4, Vector3.new(0, 3.5, 0))
		corona.AlwaysOnTop = true
		local lider: Player? = nil

		ronda:Bucle(0.25, function()
			for _, jugador in ronda:Vivos() do
				local raiz = Jugadores.Raiz(jugador)
				if raiz then
					local plano = Vector3.new(raiz.Position.X - A.X, 0, raiz.Position.Z - A.Z).Magnitude
					local altura = raiz.Position.Y - A.Y
					if plano <= RADIO_ZONA and altura > ALTURA_ZONA and altura < ALTURA_ZONA + 10 * ronda.Escala then
						ronda:SumarPuntaje(jugador, 0.25)
					end
				end
			end

			-- ¿Quién va ganando?
			local mejor: Player? = nil
			local mejorPuntaje = 0
			for _, jugador in ronda:Vivos() do
				local p = ronda:ObtenerPuntaje(jugador)
				if p > mejorPuntaje then
					mejor, mejorPuntaje = jugador, p
				end
			end
			if mejor ~= lider then
				lider = mejor
				local cabeza = if mejor and mejor.Character then mejor.Character:FindFirstChild("Head") else nil
				if mejor and cabeza and cabeza:IsA("BasePart") then
					corona.Adornee = cabeza
					ronda:Feed(`👑 ¡{mejor.DisplayName} es el nuevo REY!`)
				else
					corona.Adornee = soporte
				end
			end
		end)
	end,
}

return Minijuego
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">SueloQueCae</string>
            <string name="Source"><![CDATA[--!strict
-- 🟦 SUELO QUE CAE: 3 pisos de baldosas que desaparecen al pisarlas. ¡No te pares!

local TweenService = game:GetService("TweenService")

local C = require(script.Parent.Parent.Constructor)
local Jugadores = require(script.Parent.Parent.Jugadores)
local Ronda = require(script.Parent.Parent.Ronda)

type Ronda = Ronda.Ronda

local PISOS = 3
local SEPARACION = 22 -- altura entre pisos
local TAMANO = 7
local PASO = 7.4
local RADIO = 44

local COLORES_PISO = {
	Color3.fromRGB(0, 210, 211),
	Color3.fromRGB(255, 107, 203),
	Color3.fromRGB(255, 221, 89),
}

local ROJO = Color3.fromRGB(255, 71, 87)
local BLANCO = Color3.new(1, 1, 1)

local Minijuego: Ronda.Minijuego = {
	Id = "SueloQueCae",
	Nombre = "Suelo que Cae",
	Emoji = "🟦",
	Descripcion = "¡Las baldosas desaparecen al pisarlas! Hay 3 pisos encima de la lava. Sé el último en pie.",
	Tipo = "supervivencia",
	Duracion = 120,
	AlturaMuerte = -(PISOS - 1) * SEPARACION - 10,

	Construir = function(ronda: Ronda): { CFrame }
		local A = ronda.Centro
		local baldosas = Instance.new("Folder")
		baldosas.Name = "Baldosas"
		baldosas.Parent = ronda.Carpeta

		local n = math.ceil(RADIO / PASO)
		for piso = 1, PISOS do
			local y = A.Y - (piso - 1) * SEPARACION
			for ix = -n, n do
				for iz = -n, n do
					local x, z = ix * PASO, iz * PASO
					if x * x + z * z <= RADIO * RADIO then
						C.Parte({
							Name = "Baldosa",
							Size = Vector3.new(TAMANO, 1.2, TAMANO),
							CFrame = CFrame.new(A.X + x, y - 0.6, A.Z + z),
							Color = COLORES_PISO[piso],
							Atributos = { Piso = piso },
							Parent = baldosas,
						})
					end
				end
			end
		end

		C.Parte({
			Name = "Lava",
			Size = Vector3.new(180, 2, 180),
			CFrame = CFrame.new(A.X, A.Y - (PISOS - 1) * SEPARACION - 20, A.Z),
			Color = Color3.fromRGB(255, 90, 0),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			Parent = ronda.Carpeta,
		})

		return C.Circulo(A, 24, 8)
	end,

	Iniciar = function(ronda: Ronda)
		local baldosas = ronda.Carpeta:FindFirstChild("Baldosas")
		if not baldosas then
			return
		end
		local inicio = os.clock()
		local tocadas: { [BasePart]: boolean } = {}

		local function romper(baldosa: BasePart, retraso: number)
			if tocadas[baldosa] then
				return
			end
			tocadas[baldosa] = true
			baldosa.Color = BLANCO
			task.delay(retraso * 0.3, function()
				baldosa.Color = ROJO
			end)
			task.delay(retraso, function()
				baldosa.CanCollide = false
				baldosa.CanQuery = false
				TweenService:Create(baldosa, TweenInfo.new(0.25), { Transparency = 1 }):Play()
				task.delay(0.3, function()
					baldosa:Destroy()
				end)
			end)
		end

		local filtro = OverlapParams.new()
		filtro.FilterType = Enum.RaycastFilterType.Include
		filtro.FilterDescendantsInstances = { baldosas }

		-- Mira qué baldosas hay bajo los pies de cada jugador.
		ronda:Bucle(0.05, function()
			local transcurrido = os.clock() - inicio
			local retraso = if transcurrido > 60 then 0.4 else 0.6
			for _, jugador in ronda:Vivos() do
				local raiz = Jugadores.Raiz(jugador)
				if raiz then
					local pies = raiz.Position - Vector3.new(0, 3.1 * ronda.Escala, 0)
					local caja = Vector3.new(2.4 * ronda.Escala, 1.8, 2.4 * ronda.Escala)
					for _, parte in workspace:GetPartBoundsInBox(CFrame.new(pies), caja, filtro) do
						romper(parte, retraso)
					end
				end
			end
		end)

		-- A partir de los 40 segundos, ¡TERREMOTO! Caen baldosas solas.
		task.spawn(function()
			if not ronda:Esperar(40) then
				return
			end
			ronda:Anunciar("🌋 ¡TERREMOTO!", Color3.fromRGB(255, 120, 0), 2)
			while ronda.Activa do
				local lista = baldosas:GetChildren()
				for _ = 1, 3 do
					if #lista > 0 then
						local elegida = lista[math.random(1, #lista)]
						if elegida:IsA("BasePart") then
							romper(elegida, 1.2)
						end
					end
				end
				task.wait(0.6)
			end
		end)
	end,
}

return Minijuego
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">SumoHielo</string>
            <string name="Source"><![CDATA[--!strict
-- 🧊 SUMO EN EL HIELO: pista de hielo resbaladiza que encoge, ráfagas de viento
-- y Martillos Locos. ¡Échalos a todos al agua helada!

local TweenService = game:GetService("TweenService")

local C = require(script.Parent.Parent.Constructor)
local Efectos = require(script.Parent.Parent.Efectos)
local Jugadores = require(script.Parent.Parent.Jugadores)
local Ronda = require(script.Parent.Parent.Ronda)

type Ronda = Ronda.Ronda

local RADIO_INICIAL = 32
local RADIO_MINIMO = 10

local Minijuego: Ronda.Minijuego = {
	Id = "SumoHielo",
	Nombre = "Sumo en el Hielo",
	Emoji = "🧊",
	Descripcion = "¡Pista de HIELO que encoge! Usa el Martillo Loco para echar a los demás. Cuidado con el viento...",
	Tipo = "supervivencia",
	Duracion = 90,
	AlturaMuerte = -15,
	Herramienta = true,
	FuerzaMartillo = 1.25,

	Construir = function(ronda: Ronda): { CFrame }
		local A = ronda.Centro
		C.Disco(A, RADIO_INICIAL, 4, {
			Name = "PistaHielo",
			Color = Color3.fromRGB(175, 225, 255),
			Material = Enum.Material.Ice,
			CustomPhysicalProperties = PhysicalProperties.new(0.9, 0.03, 0.1, 100, 1),
			Parent = ronda.Carpeta,
		})
		C.Disco(A - Vector3.new(0, 0.4, 0), RADIO_INICIAL + 1, 3.4, {
			Name = "BordeHielo",
			Color = Color3.fromRGB(0, 210, 211),
			Material = Enum.Material.Neon,
			Parent = ronda.Carpeta,
		})
		C.Parte({
			Name = "AguaHelada",
			Size = Vector3.new(220, 1, 220),
			CFrame = CFrame.new(A - Vector3.new(0, 35, 0)),
			Color = Color3.fromRGB(40, 120, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.3,
			CanCollide = false,
			CanQuery = false,
			Parent = ronda.Carpeta,
		})

		-- Nieve cayendo.
		local nube = C.Parte({
			Name = "Nube",
			Size = Vector3.new(90, 1, 90),
			CFrame = CFrame.new(A + Vector3.new(0, 45, 0)),
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Parent = ronda.Carpeta,
		})
		local nieve = Instance.new("ParticleEmitter")
		nieve.EmissionDirection = Enum.NormalId.Bottom
		nieve.Rate = 80
		nieve.Lifetime = NumberRange.new(6, 9)
		nieve.Speed = NumberRange.new(5, 9)
		nieve.Size = NumberSequence.new(0.35)
		nieve.Color = ColorSequence.new(Color3.new(1, 1, 1))
		nieve.LightEmission = 0.5
		nieve.SpreadAngle = Vector2.new(15, 15)
		nieve.Parent = nube

		return C.Circulo(A, 18, 8)
	end,

	Iniciar = function(ronda: Ronda)
		local pista = ronda.Carpeta:FindFirstChild("PistaHielo")
		local borde = ronda.Carpeta:FindFirstChild("BordeHielo")

		-- La pista encoge cada 10 segundos.
		task.spawn(function()
			local radio = RADIO_INICIAL
			while ronda:Esperar(10) do
				if radio <= RADIO_MINIMO then
					break
				end
				radio = math.max(RADIO_MINIMO, radio - 4)
				ronda:Anunciar("⚠️ ¡LA PISTA ENCOGE!", Color3.fromRGB(0, 210, 211), 1.5)
				if pista and pista:IsA("BasePart") then
					TweenService:Create(pista, TweenInfo.new(1.5), { Size = Vector3.new(4, radio * 2, radio * 2) }):Play()
				end
				if borde and borde:IsA("BasePart") then
					TweenService:Create(borde, TweenInfo.new(1.5), { Size = Vector3.new(3.4, radio * 2 + 2, radio * 2 + 2) })
						:Play()
				end
			end
		end)

		-- Ráfagas de viento que empujan a todos hacia el mismo lado.
		task.spawn(function()
			while ronda:Esperar(math.random(12, 16)) do
				local angulo = math.random() * math.pi * 2
				local direccion = Vector3.new(math.cos(angulo), 0, math.sin(angulo))
				ronda:Anunciar("💨 ¡RÁFAGA DE VIENTO!", Color3.fromRGB(200, 230, 255), 1.5)
				task.wait(1)
				for _, jugador in ronda:Vivos() do
					if Jugadores.Raiz(jugador) then
						Efectos.Empujar(jugador, direccion * 55 + Vector3.new(0, 14, 0), 0.4)
					end
				end
			end
		end)
	end,
}

return Minijuego
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Modificadores</string>
          <string name="Source"><![CDATA[--!strict
-- 🌀 MODOS LOCOS: cada ronda puede tener un modificador que lo cambia todo.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Compartido.Config)
local Remotos = require(ReplicatedStorage.Compartido.Remotos)

export type Modificador = {
	Id: string,
	Nombre: string,
	Emoji: string,
	Descripcion: string,
	Peso: number, -- cuanto más alto, más veces sale
	Gravedad: number?,
	MultVelocidad: number?,
	MultSalto: number?,
	Escala: number?,
	Hielo: boolean?,
	EfectosCliente: { string }?,
}

local Modificadores = {}

Modificadores.Lista = {
	{
		Id = "Normal",
		Nombre = "Sin locura",
		Emoji = "😐",
		Descripcion = "Ronda normal... por ahora.",
		Peso = 2,
	},
	{
		Id = "Lunar",
		Nombre = "Gravedad Lunar",
		Emoji = "🌙",
		Descripcion = "¡Saltos de astronauta y vuelos eternos!",
		Peso = 3,
		Gravedad = 55,
	},
	{
		Id = "Turbo",
		Nombre = "Modo Turbo",
		Emoji = "⚡",
		Descripcion = "¡Todo el mundo corre el doble de rápido!",
		Peso = 3,
		MultVelocidad = 1.9,
	},
	{
		Id = "Gigantes",
		Nombre = "Ataque de Gigantes",
		Emoji = "🦖",
		Descripcion = "¡Sois ENORMES!",
		Peso = 2,
		Escala = 1.8,
	},
	{
		Id = "Mini",
		Nombre = "Mini Locos",
		Emoji = "🐜",
		Descripcion = "¡Sois diminutos como hormigas!",
		Peso = 2,
		Escala = 0.5,
	},
	{
		Id = "Saltarin",
		Nombre = "Súper Salto",
		Emoji = "🦘",
		Descripcion = "¡Piernas de canguro para todos!",
		Peso = 2,
		MultSalto = 1.8,
	},
	{
		Id = "Disco",
		Nombre = "Noche Disco",
		Emoji = "🪩",
		Descripcion = "¡Se apagan las luces y empieza la fiesta!",
		Peso = 2,
		EfectosCliente = { "Disco" },
	},
	{
		Id = "OjoPez",
		Nombre = "Ojo de Pez",
		Emoji = "🐟",
		Descripcion = "¡La cámara se vuelve loquísima!",
		Peso = 2,
		EfectosCliente = { "OjoPez" },
	},
	{
		Id = "Hielo",
		Nombre = "Todo es Hielo",
		Emoji = "🧊",
		Descripcion = "¡Cuidado, que resbala!",
		Peso = 2,
		Hielo = true,
	},
	{
		Id = "Caos",
		Nombre = "CAOS TOTAL",
		Emoji = "🌀",
		Descripcion = "¡Varios modos locos a la vez!",
		Peso = 2,
	},
} :: { Modificador }

local function porId(id: string): Modificador?
	for _, m in Modificadores.Lista do
		if m.Id == id then
			return m
		end
	end
	return nil
end

local function elegirPonderado(lista: { Modificador }): Modificador
	local total = 0
	for _, m in lista do
		total += m.Peso
	end
	local tirada = math.random() * total
	for _, m in lista do
		tirada -= m.Peso
		if tirada <= 0 then
			return m
		end
	end
	return lista[#lista]
end

-- Mezcla varios modificadores en uno solo (para CAOS TOTAL).
local function mezclar(partes: { Modificador }): Modificador
	local resultado: Modificador = {
		Id = "Caos",
		Nombre = "CAOS TOTAL",
		Emoji = "🌀",
		Descripcion = "",
		Peso = 0,
		EfectosCliente = {},
	}
	local nombres = {}
	for _, m in partes do
		table.insert(nombres, m.Emoji .. " " .. m.Nombre)
		if m.Gravedad then
			resultado.Gravedad = math.min(resultado.Gravedad or math.huge, m.Gravedad)
		end
		if m.MultVelocidad then
			resultado.MultVelocidad = (resultado.MultVelocidad or 1) * m.MultVelocidad
		end
		if m.MultSalto then
			resultado.MultSalto = (resultado.MultSalto or 1) * m.MultSalto
		end
		if m.Escala and not resultado.Escala then
			resultado.Escala = m.Escala
		end
		if m.Hielo then
			resultado.Hielo = true
		end
		if m.EfectosCliente then
			for _, efecto in m.EfectosCliente do
				table.insert(resultado.EfectosCliente :: { string }, efecto)
			end
		end
	end
	resultado.Descripcion = table.concat(nombres, " + ")
	return resultado
end

local ultimoId = ""

-- Elige un modo loco al azar (sin repetir el de la ronda anterior).
-- La primera ronda de cada partida es más tranquila.
function Modificadores.Elegir(numeroRonda: number): Modificador
	if numeroRonda == 1 and math.random() < 0.5 then
		ultimoId = "Normal"
		return porId("Normal") :: Modificador
	end
	local candidatos = {}
	for _, m in Modificadores.Lista do
		if m.Id ~= ultimoId then
			table.insert(candidatos, m)
		end
	end
	local elegido = elegirPonderado(candidatos)
	ultimoId = elegido.Id
	if elegido.Id ~= "Caos" then
		return elegido
	end

	-- CAOS: junta 2 o 3 modos distintos (sin Normal, sin repetir).
	local disponibles = {}
	for _, m in Modificadores.Lista do
		if m.Id ~= "Normal" and m.Id ~= "Caos" then
			table.insert(disponibles, m)
		end
	end
	local partes = {}
	local cantidad = math.random(2, 3)
	for _ = 1, cantidad do
		if #disponibles == 0 then
			break
		end
		local indice = math.random(1, #disponibles)
		local m = table.remove(disponibles, indice) :: Modificador
		-- No mezclar gigantes con mini.
		if m.Escala then
			for i = #disponibles, 1, -1 do
				if disponibles[i].Escala then
					table.remove(disponibles, i)
				end
			end
		end
		table.insert(partes, m)
	end
	return mezclar(partes)
end

-- Cosas que afectan a todo el mundo (gravedad, efectos visuales).
function Modificadores.AplicarMundo(mod: Modificador)
	workspace.Gravity = mod.Gravedad or Config.GRAVEDAD_NORMAL
	if mod.EfectosCliente then
		for _, efecto in mod.EfectosCliente do
			Remotos.Efecto:FireAllClients(efecto, true)
		end
	end
end

function Modificadores.QuitarMundo()
	workspace.Gravity = Config.GRAVEDAD_NORMAL
	Remotos.Efecto:FireAllClients("Todo", false)
end

-- Convierte todo el suelo de la arena en hielo resbaladizo.
function Modificadores.AplicarHielo(carpeta: Instance)
	local hielo = PhysicalProperties.new(0.9, 0.02, 0.1, 100, 1)
	for _, d in carpeta:GetDescendants() do
		if d:IsA("BasePart") and d.Anchored and d.CanCollide and d.Transparency < 1 then
			d.Material = Enum.Material.Ice
			d.CustomPhysicalProperties = hielo
		end
	end
end

return Modificadores
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">Ronda</string>
          <string name="Source"><![CDATA[--!strict
-- 🎮 Una ronda de minijuego: quién sigue vivo, puntos, eliminaciones y limpieza.
-- Los minijuegos usan las funciones de aquí para no repetir código.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Compartido.Config)
local Remotos = require(ReplicatedStorage.Compartido.Remotos)
local Efectos = require(script.Parent.Efectos)
local Herramientas = require(script.Parent.Herramientas)
local Jugadores = require(script.Parent.Jugadores)
local Modificadores = require(script.Parent.Modificadores)

export type TipoJuego = "supervivencia" | "puntos" | "carrera"
type EstadoJugador = "vivo" | "eliminado" | "meta" | "fuera"

export type Minijuego = {
	Id: string,
	Nombre: string,
	Emoji: string,
	Descripcion: string,
	Tipo: TipoJuego,
	Duracion: number,
	AlturaMuerte: number, -- relativa al centro de la arena (ej: -30)
	Herramienta: boolean?, -- ¿dar Martillo Loco?
	FuerzaMartillo: number?,
	MultVelocidad: number?,
	MultSalto: number?,
	UnidadPuntaje: string?, -- texto para el marcador (ej: "👑")
	Construir: (ronda: Ronda) -> { CFrame },
	Iniciar: (ronda: Ronda) -> (),
	AlCaer: ((ronda: Ronda, jugador: Player) -> ())?,
	AlEliminar: ((ronda: Ronda, jugador: Player) -> ())?,
}

export type Fila = {
	Jugador: Player,
	Puesto: number,
	Detalle: string,
}

local Ronda = {}
Ronda.__index = Ronda

type Datos = {
	Minijuego: Minijuego,
	Modificador: Modificadores.Modificador,
	Participantes: { Player },
	Estados: { [Player]: EstadoJugador },
	Puntaje: { [Player]: number },
	OrdenEliminacion: { Player },
	OrdenLlegada: { Player },
	UltimaCaida: { [Player]: number },
	Colores: { [Player]: Color3 },
	Carpeta: Folder,
	Centro: Vector3,
	Spawns: { CFrame },
	Escala: number,
	Velocidad: number,
	Salto: number,
	Iniciada: boolean,
	Activa: boolean,
	Terminada: boolean,
	TiempoRestante: number,
	Conexiones: { RBXScriptConnection },
}

export type Ronda = typeof(setmetatable({} :: Datos, Ronda))

local FRASES_CAIDA = {
	"se cayó al vacío 🕳️",
	"aprendió a volar... mal 🪽",
	"se fue de vacaciones al abismo 🏖️",
	"dijo adiós muy fuerte 👋",
	"cayó como una patata 🥔",
	"se tiró de cabeza 🤸",
	"no vio el borde 🙈",
}

function Ronda.new(minijuego: Minijuego, modificador: Modificadores.Modificador, participantes: { Player }): Ronda
	local carpeta = Instance.new("Folder")
	carpeta.Name = "Arena"

	local datos: Datos = {
		Minijuego = minijuego,
		Modificador = modificador,
		Participantes = table.clone(participantes),
		Estados = {},
		Puntaje = {},
		OrdenEliminacion = {},
		OrdenLlegada = {},
		UltimaCaida = {},
		Colores = {},
		Carpeta = carpeta,
		Centro = Config.ARENA_CENTRO,
		Spawns = {},
		Escala = modificador.Escala or 1,
		Velocidad = Config.VELOCIDAD_BASE * (minijuego.MultVelocidad or 1) * (modificador.MultVelocidad or 1),
		Salto = Config.SALTO_BASE * (minijuego.MultSalto or 1) * (modificador.MultSalto or 1),
		Iniciada = false,
		Activa = true,
		Terminada = false,
		TiempoRestante = minijuego.Duracion,
		Conexiones = {},
	}
	for i, jugador in datos.Participantes do
		datos.Estados[jugador] = "vivo"
		datos.Puntaje[jugador] = 0
		datos.Colores[jugador] = Config.COLORES[((i - 1) % #Config.COLORES) + 1]
	end
	return setmetatable(datos, Ronda)
end

-- ===== Utilidades para los minijuegos =====

function Ronda.Conectar(self: Ronda, senal: RBXScriptSignal, funcion: (...any) -> ()): RBXScriptConnection
	local conexion = senal:Connect(funcion)
	table.insert(self.Conexiones, conexion)
	return conexion
end

-- Repite `funcion` cada `intervalo` segundos mientras la ronda siga activa.
function Ronda.Bucle(self: Ronda, intervalo: number, funcion: () -> ())
	task.spawn(function()
		while self.Activa do
			local ok, err = pcall(funcion :: any)
			if not ok then
				warn("[LocuraTotal] Error en el minijuego:", err)
			end
			task.wait(intervalo)
		end
	end)
end

-- Espera y devuelve si la ronda sigue activa (para salir de bucles largos).
function Ronda.Esperar(self: Ronda, segundos: number): boolean
	task.wait(segundos)
	return self.Activa
end

function Ronda.Vivos(self: Ronda): { Player }
	local lista = {}
	for _, jugador in self.Participantes do
		if self.Estados[jugador] == "vivo" then
			table.insert(lista, jugador)
		end
	end
	return lista
end

function Ronda.EstaVivo(self: Ronda, jugador: Player): boolean
	return self.Estados[jugador] == "vivo"
end

-- Si `parte` pertenece al personaje de un jugador vivo de la ronda, lo devuelve.
function Ronda.JugadorDeParte(self: Ronda, parte: Instance): Player?
	local modelo = parte:FindFirstAncestorOfClass("Model")
	while modelo do
		local jugador = Players:GetPlayerFromCharacter(modelo)
		if jugador then
			if self.Estados[jugador] == "vivo" then
				return jugador
			end
			return nil
		end
		modelo = modelo:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function Ronda.Teletransportar(self: Ronda, jugador: Player, destino: CFrame)
	local personaje = jugador.Character
	if not personaje then
		return
	end
	local raiz = Jugadores.Raiz(jugador)
	if raiz then
		raiz.AssemblyLinearVelocity = Vector3.zero
	end
	personaje:PivotTo(destino + Vector3.new(0, 3.2 * self.Escala + 0.5, 0))
end

function Ronda.SumarPuntaje(self: Ronda, jugador: Player, cantidad: number)
	self.Puntaje[jugador] = (self.Puntaje[jugador] or 0) + cantidad
end

function Ronda.FijarPuntaje(self: Ronda, jugador: Player, cantidad: number)
	self.Puntaje[jugador] = cantidad
end

function Ronda.ObtenerPuntaje(self: Ronda, jugador: Player): number
	return self.Puntaje[jugador] or 0
end

function Ronda.Feed(_self: Ronda, texto: string)
	Remotos.Feed:FireAllClients(texto)
end

function Ronda.Anunciar(_self: Ronda, texto: string, color: Color3?, duracion: number?)
	Remotos.Anuncio:FireAllClients(texto, { Color = color, Duracion = duracion })
end

-- ===== Eliminaciones, llegadas y caídas =====

function Ronda.ComprobarFin(self: Ronda)
	if self.Terminada or not self.Iniciada then
		return
	end
	local vivos = #self:Vivos()
	if self.Minijuego.Tipo == "supervivencia" then
		local umbral = if #self.Participantes >= 2 then 1 else 0
		if vivos <= umbral then
			self.Terminada = true
		end
	elseif vivos == 0 then
		self.Terminada = true
	end
end

function Ronda.Eliminar(self: Ronda, jugador: Player, motivo: string?)
	if self.Estados[jugador] ~= "vivo" then
		return
	end
	self.Estados[jugador] = "eliminado"
	table.insert(self.OrdenEliminacion, jugador)
	Jugadores.EnRonda[jugador] = nil

	self:Feed(`💀 {jugador.DisplayName} {motivo or "quedó eliminado"}`)
	Remotos.Anuncio:FireClient(jugador, "¡ELIMINADO!", { Color = Color3.fromRGB(255, 71, 87), Duracion = 2 })

	local alEliminar = self.Minijuego.AlEliminar
	if alEliminar then
		task.spawn(alEliminar, self, jugador)
	end

	task.delay(1.5, function()
		if jugador.Parent == Players and not Jugadores.EnRonda[jugador] then
			Jugadores.Reaparecer(jugador)
		end
	end)

	self:ComprobarFin()
end

-- Para carreras: el jugador ha cruzado la meta.
function Ronda.Llegar(self: Ronda, jugador: Player)
	if self.Estados[jugador] ~= "vivo" then
		return
	end
	self.Estados[jugador] = "meta"
	table.insert(self.OrdenLlegada, jugador)
	local puesto = #self.OrdenLlegada

	self:Feed(`🏁 {jugador.DisplayName} llegó a la meta en el puesto {puesto}`)
	Remotos.Anuncio:FireClient(jugador, `¡META! Puesto {puesto}`, { Color = Color3.fromRGB(46, 213, 115), Duracion = 2.5 })
	local raiz = Jugadores.Raiz(jugador)
	if raiz then
		Efectos.Confeti(raiz.Position + Vector3.new(0, 4, 0), 100)
	end

	self:ComprobarFin()
end

-- Para juegos que no son de supervivencia: si te caes, vuelves a empezar.
function Ronda.Caer(self: Ronda, jugador: Player)
	local ahora = os.clock()
	if ahora - (self.UltimaCaida[jugador] or 0) < 1 then
		return
	end
	self.UltimaCaida[jugador] = ahora

	local alCaer = self.Minijuego.AlCaer
	if alCaer then
		alCaer(self, jugador)
	elseif #self.Spawns > 0 then
		self:Teletransportar(jugador, self.Spawns[math.random(1, #self.Spawns)])
	end
end

-- Un jugador se ha ido del juego: deja de contar (sin mensaje de "eliminado").
function Ronda.Abandonar(self: Ronda, jugador: Player)
	local estado = self.Estados[jugador]
	if estado == nil or estado == "fuera" then
		return
	end
	self.Estados[jugador] = "fuera"
	Jugadores.EnRonda[jugador] = nil
	if estado == "vivo" then
		self:Feed(`🚪 {jugador.DisplayName} abandonó la locura`)
		local alEliminar = self.Minijuego.AlEliminar
		if alEliminar then
			task.spawn(alEliminar, self, jugador)
		end
	end
	self:ComprobarFin()
end

-- Se ejecuta cada frame: revisa caídas y muertes.
function Ronda.Vigilar(self: Ronda)
	if not self.Activa or not self.Iniciada then
		return
	end
	local limite = self.Centro.Y + self.Minijuego.AlturaMuerte
	for _, jugador in self.Participantes do
		if self.Estados[jugador] == "vivo" and jugador.Parent ~= Players then
			self:Abandonar(jugador)
		elseif self.Estados[jugador] == "vivo" then
			local humanoide = Jugadores.Humanoide(jugador)
			local raiz = Jugadores.Raiz(jugador)
			if not humanoide or not raiz or humanoide.Health <= 0 then
				self:Eliminar(jugador, "se desintegró 💨")
			elseif raiz.Position.Y < limite then
				if self.Minijuego.Tipo == "supervivencia" then
					self:Eliminar(jugador, FRASES_CAIDA[math.random(1, #FRASES_CAIDA)])
				else
					self:Caer(jugador)
				end
			end
		end
	end
end

-- ===== Ciclo de vida de la ronda =====

-- 1) Construye la arena del minijuego.
function Ronda.Construir(self: Ronda)
	local vieja = workspace:FindFirstChild("Arena")
	if vieja then
		vieja:Destroy()
	end
	self.Carpeta.Parent = workspace
	self.Spawns = self.Minijuego.Construir(self)
	if self.Modificador.Hielo then
		Modificadores.AplicarHielo(self.Carpeta)
	end
end

-- 2) Lleva a todos a la arena, aplica el modo loco y los congela.
function Ronda.Preparar(self: Ronda)
	-- Si alguien se va (incluso durante la cuenta atrás), deja de contar.
	self:Conectar(Players.PlayerRemoving, function(jugador: Player)
		self:Abandonar(jugador)
	end)
	for i, jugador in self.Participantes do
		local personaje = jugador.Character
		local humanoide = Jugadores.Humanoide(jugador)
		if personaje and humanoide and humanoide.Health > 0 then
			Jugadores.EnRonda[jugador] = true
			if self.Escala ~= 1 then
				local escala = self.Escala
				pcall(function()
					personaje:ScaleTo(escala)
				end)
			end
			humanoide.UseJumpPower = true
			humanoide.WalkSpeed = 0
			humanoide.JumpPower = 0
			if #self.Spawns > 0 then
				self:Teletransportar(jugador, self.Spawns[((i - 1) % #self.Spawns) + 1])
			end
			if self.Minijuego.Herramienta then
				Herramientas.DarMartillo(jugador, self.Colores[jugador], self.Minijuego.FuerzaMartillo)
			end
		else
			self.Estados[jugador] = "fuera"
		end
	end
end

-- 3) ¡YA! Descongela a todos y arranca el minijuego.
function Ronda.Iniciar(self: Ronda)
	self.Iniciada = true
	for _, jugador in self:Vivos() do
		local humanoide = Jugadores.Humanoide(jugador)
		if humanoide then
			humanoide.WalkSpeed = self.Velocidad
			humanoide.JumpPower = self.Salto
		end
	end

	self:Conectar(RunService.Heartbeat, function()
		self:Vigilar()
	end)
	for _, jugador in self.Participantes do
		if jugador.Parent ~= Players then
			self:Abandonar(jugador)
		end
	end

	task.spawn(function()
		local ok, err = pcall(self.Minijuego.Iniciar :: any, self)
		if not ok then
			warn("[LocuraTotal] Error al iniciar el minijuego:", err)
		end
	end)

	self:ComprobarFin()
end

-- 4) Para todo (los bucles de los minijuegos terminan solos).
function Ronda.Detener(self: Ronda)
	self.Activa = false
	self.Terminada = true
	for _, conexion in self.Conexiones do
		conexion:Disconnect()
	end
	table.clear(self.Conexiones)
end

-- 5) Devuelve a todos al lobby y borra la arena.
function Ronda.Limpiar(self: Ronda)
	self:Detener()
	for _, jugador in self.Participantes do
		local estaba = Jugadores.EnRonda[jugador]
		Jugadores.EnRonda[jugador] = nil
		if estaba and jugador.Parent == Players then
			Jugadores.Reaparecer(jugador)
		end
	end
	local carpeta = self.Carpeta
	task.delay(1, function()
		carpeta:Destroy()
	end)
end

-- ===== Resultados =====

local function ordenarPorPuntaje(self: Ronda, lista: { Player }, desde: number, filas: { Fila }, sufijo: string)
	table.sort(lista, function(a, b)
		return self:ObtenerPuntaje(a) > self:ObtenerPuntaje(b)
	end)
	local puestoAnterior = desde
	local puntajeAnterior: number? = nil
	for i, jugador in lista do
		local puntaje = self:ObtenerPuntaje(jugador)
		local puesto = if puntajeAnterior ~= nil and puntaje == puntajeAnterior then puestoAnterior else desde + i - 1
		puestoAnterior = puesto
		puntajeAnterior = puntaje
		table.insert(filas, {
			Jugador = jugador,
			Puesto = puesto,
			Detalle = `{math.floor(puntaje)} {sufijo}`,
		})
	end
end

function Ronda.Ranking(self: Ronda): { Fila }
	local filas: { Fila } = {}
	local function sigue(jugador: Player): boolean
		return jugador.Parent == Players and self.Estados[jugador] ~= "fuera"
	end

	local tipo = self.Minijuego.Tipo
	if tipo == "supervivencia" then
		local supervivientes = 0
		for _, jugador in self.Participantes do
			if self.Estados[jugador] == "vivo" and sigue(jugador) then
				supervivientes += 1
				table.insert(filas, { Jugador = jugador, Puesto = 1, Detalle = "¡Sobrevivió!" })
			end
		end
		local siguiente = supervivientes + 1
		for i = #self.OrdenEliminacion, 1, -1 do
			local jugador = self.OrdenEliminacion[i]
			if sigue(jugador) then
				table.insert(filas, { Jugador = jugador, Puesto = siguiente, Detalle = "Eliminado" })
				siguiente += 1
			end
		end
	elseif tipo == "puntos" then
		local lista = {}
		for _, jugador in self.Participantes do
			if sigue(jugador) then
				table.insert(lista, jugador)
			end
		end
		ordenarPorPuntaje(self, lista, 1, filas, self.Minijuego.UnidadPuntaje or "pts")
	else
		for _, jugador in self.OrdenLlegada do
			if sigue(jugador) then
				table.insert(filas, { Jugador = jugador, Puesto = #filas + 1, Detalle = "🏁 Meta" })
			end
		end
		local resto = {}
		for _, jugador in self.Participantes do
			if self.Estados[jugador] ~= "meta" and sigue(jugador) then
				table.insert(resto, jugador)
			end
		end
		local antes = #filas
		ordenarPorPuntaje(self, resto, antes + 1, filas, "m")
		for i = antes + 1, #filas do
			filas[i].Detalle = "No llegó (" .. filas[i].Detalle .. ")"
		end
	end
	return filas
end

-- Información para la barra de arriba de cada jugador.
function Ronda.EstadoCliente(self: Ronda): { [string]: any }
	local vivosIds = {}
	for _, jugador in self:Vivos() do
		table.insert(vivosIds, jugador.UserId)
	end

	local marcador = nil
	if self.Minijuego.Tipo == "puntos" then
		local lista = {}
		for _, jugador in self.Participantes do
			if jugador.Parent == Players and self.Estados[jugador] ~= "fuera" then
				table.insert(lista, jugador)
			end
		end
		table.sort(lista, function(a, b)
			return self:ObtenerPuntaje(a) > self:ObtenerPuntaje(b)
		end)
		marcador = {}
		for _, jugador in lista do
			table.insert(marcador, {
				Nombre = jugador.DisplayName,
				Puntos = math.floor(self:ObtenerPuntaje(jugador)),
				Id = jugador.UserId,
			})
		end
	end

	return {
		Fase = "ronda",
		Texto = `{self.Minijuego.Emoji} {self.Minijuego.Nombre}`,
		Tiempo = self.TiempoRestante,
		Modo = `{self.Modificador.Emoji} {self.Modificador.Nombre}`,
		Vivos = #vivosIds,
		Total = #self.Participantes,
		VivosIds = vivosIds,
		Marcador = marcador,
		Unidad = self.Minijuego.UnidadPuntaje,
		Llegados = if self.Minijuego.Tipo == "carrera" then #self.OrdenLlegada else nil,
	}
end

return Ronda
]]></string>
        </Properties>
      </Item>
